    }
    .cam-top-close { font-size: 1.5rem; cursor: pointer; color: #fff; padding: 4px; line-height: 1; }
    .cam-top-actions { display: flex; gap: 20px; align-items: center; font-size: 1.25rem; color: #fff; }
    .cam-top-actions span { cursor: pointer; }
    .cam-hd-badge { font-size: 0.75rem; border: 1.5px solid #fff; padding: 1px 5px; border-radius: 4px; font-weight: 800; letter-spacing: 0.5px; }

    .cam-viewport { flex: 1; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #000; height: 100%; width: 100%; }
    #cameraVideo { width: 100%; height: 100%; object-fit: cover; }
    #liveBoundaryCanvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; }
    #trackCanvas { display: none; }

    #idCardGuideOverlay { position: absolute; inset: 0; display: none; pointer-events: none; z-index: 15; align-items: center; justify-content: center; flex-direction: column; gap: 12px; }
    .id-card-frame { width: 82%; max-width: 320px; aspect-ratio: 1.586; border: 2px dashed #00f0b5; border-radius: 12px; box-shadow: 0 0 0 9999px rgba(0,0,0,0.55); position: relative; }
    .id-card-badge { background: rgba(0, 240, 181, 0.9); color: #042f2e; font-weight: 700; font-size: 0.8rem; padding: 4px 14px; border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.3); }

    #camPermissionNotice { position: absolute; inset: 0; background: #0a0f1d; display: none; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center; gap: 14px; z-index: 25; }

    .cam-bottom-section {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      display: flex;
      flex-direction: column;
      background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.65) 75%, transparent 100%);
      padding-bottom: env(safe-area-inset-bottom, 12px);
      z-index: 30;
    }
    .cam-mode-indicator {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 24px;
      padding: 8px 0 16px 0;
      font-size: 0.95rem;
      font-weight: 600;
      color: #94a3b8;
    }
    .cam-mode-item { cursor: pointer; position: relative; padding: 4px 0; }
    .cam-mode-item.active { color: #00f0b5; font-weight: 700; }
    .cam-mode-item.active::after {
      content: "";
      position: absolute;
      bottom: -2px;
      left: 20%;
      right: 20%;
      height: 2.5px;
      background: #00f0b5;
      border-radius: 2px;
      box-shadow: 0 0 6px #00f0b5;
    }

    .cam-shutter-deck { display: flex; justify-content: space-around; align-items: center; padding: 0 20px 18px 20px; }
    .cam-shutter-outer {
      width: 74px;
      height: 74px;
      border-radius: 50%;
      background: transparent;
      border: 3.5px solid #00f0b5;
      padding: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 0 20px var(--shutter-glow);
      transition: transform 0.1s;
    }
    .cam-shutter-outer:active { transform: scale(0.92); }
    .cam-shutter-inner { width: 100%; height: 100%; background: #ffffff; border-radius: 50%; }

    .cam-deck-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      font-size: 0.72rem;
      color: #e2e8f0;
      cursor: pointer;
      min-width: 70px;
      position: relative;
    }
    .cam-deck-btn:active { transform: scale(0.95); }
    .cam-deck-icon { font-size: 1.55rem; line-height: 1; }
    .batch-badge {
      position: absolute;
      top: -4px;
      right: 12px;
      background: #00f0b5;
      color: #042f2e;
      border-radius: 50%;
      width: 20px;
      height: 20px;
      font-size: 0.72rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #000;
    }

    /* SCREEN 3: INTERACTIVE 4-CORNER CROP */
    #cropScreen { background: #0b0f19; color: #fff; z-index: 20; }
    .crop-top-bar { height: 52px; padding: 0 16px; background: #111827; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1f2937; }
    .crop-viewport { flex: 1; position: relative; display: flex; align-items: center; justify-content: center; background: #030712; overflow: hidden; touch-action: none; }
    #cropInteractiveCanvas { max-width: 100%; max-height: 100%; touch-action: none; }
    #cropLoupe {
      position: absolute;
      width: 110px;
      height: 110px;
      border-radius: 50%;
      border: 3px solid #00f0b5;
      box-shadow: 0 4px 20px rgba(0,0,0,0.7);
      display: none;
      pointer-events: none;
      z-index: 40;
      background: #000;
      overflow: hidden;
    }
    #cropLoupe canvas { width: 100%; height: 100%; }
    .loupe-crosshair { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 18px; height: 18px; pointer-events: none; }
    .loupe-crosshair::before, .loupe-crosshair::after { content: ""; position: absolute; background: #00f0b5; }
    .loupe-crosshair::before { top: 8px; left: 0; right: 0; height: 2px; }
    .loupe-crosshair::after { left: 8px; top: 0; bottom: 0; width: 2px; }
    .crop-bottom-bar { background: #111827; border-top: 1px solid #1f2937; padding: 12px 16px; display: flex; justify-content: space-around; align-items: center; }

    /* SCREEN 4: CAMSCANNER ENHANCE & REVIEW (IMAGE 2 REPLICA) */
    #reviewScreen { background: #11141c; color: #fff; z-index: 20; }
    .review-top-bar {
      height: 52px;
      padding: 0 16px;
      background: #181d28;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #222938;
    }
    .review-back-btn { font-size: 1.4rem; cursor: pointer; color: #fff; display: flex; align-items: center; }
    .review-title-box { display: flex; align-items: center; gap: 6px; cursor: pointer; }
    .review-title-text { font-weight: 700; font-size: 0.95rem; color: #fff; max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .review-add-btn { color: #00f0b5; font-weight: 700; font-size: 0.95rem; cursor: pointer; }

    .review-viewport {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0d1017;
      overflow: hidden;
      padding: 12px;
    }
    .doc-page-container { position: relative; max-width: 100%; max-height: 100%; display: flex; align-items: center; justify-content: center; }
    #displayCanvas { max-width: 100%; max-height: 100%; object-fit: contain; box-shadow: 0 6px 24px rgba(0,0,0,0.6); background: #fff; }

    .page-delete-btn {
      position: absolute;
      top: 10px;
      left: 10px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(0,0,0,0.65);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
