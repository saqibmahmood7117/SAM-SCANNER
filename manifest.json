  <input type="file" id="restoreBackupInput" accept=".json" style="display:none;" onchange="restoreBackupData(event)" />

  <!-- MODAL 1: PDF TOOLS -->
  <div class="modal-sheet" id="pdfToolsModal">
    <div class="modal-head">
      <h3>PDF Tools & Formats</h3>
