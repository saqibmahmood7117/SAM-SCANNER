    .pill-btn.primary { background: #059669; color: #fff; }

    .pill-btn.secondary { background: #334155; color: #cbd5e1; }



    #sigCanvas { background: #fff; border-radius: 8px; width: 100%; height: 160px; touch-action: none; cursor: crosshair; border: 1px solid #cbd5e1; }

