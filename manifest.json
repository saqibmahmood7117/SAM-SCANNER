      flex: 1;
      padding: 6px 0;
    }
    .nav-item.active { color: #059669; font-weight: 700; }
    .nav-item span:first-child { font-size: 1.25rem; }

    /* SCREEN 2: CAMSCANNER CAMERA (IMAGE 1 REPLICA) */
    #cameraScreen { background: #000; color: #fff; z-index: 20; }
    .cam-top-bar {
      height: 54px;
      padding: 0 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0,0,0,0.4);
