      color: #fff;
      padding: 8px 18px;
      border-radius: 24px;
      font-size: 0.82rem;
      font-weight: 600;
      box-shadow: 0 4px 14px rgba(0,0,0,0.25);
      z-index: 1000;
      display: none;
      pointer-events: none;
      backdrop-filter: blur(4px);
      text-align: center;
      white-space: nowrap;
    }
    .progress-bar-container { width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden; margin: 8px 0; display: none; }
    .progress-bar-fill { height: 100%; width: 0%; background: #059669; transition: width 0.2s; }
    .profile-card { display: flex; align-items: center; gap: 14px; background: #f8fafc; padding: 14px; border-radius: 12px; border: 1px solid #e2e8f0; }
    .profile-avatar { width: 52px; height: 52px; border-radius: 50%; background: #059669; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
