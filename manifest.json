  <!-- MODAL 4: OCR EXTRACT TEXT RESULTS -->
  <div class="modal-sheet" id="ocrModal">
    <div class="modal-head">
      <h3>Extracted Text (OCR)</h3>
      <button class="modal-close" onclick="closeModalSheet('ocrModal')">✕</button>
