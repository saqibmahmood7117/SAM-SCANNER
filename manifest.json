    /* SCREEN 2: CAMERA VIEW (IMAGE 1) */
    #cameraScreen { background: #000; color: #fff; z-index: 20; }
    .cam-top-bar {
      height: 54px;
      padding: 0 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0,0,0,0.4);
