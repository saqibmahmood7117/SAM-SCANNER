      cursor: pointer;
      box-shadow: 0 4px 14px rgba(0, 201, 151, 0.4);
      flex-shrink: 0;
      margin-left: 8px;
      transition: transform 0.1s;
    }
    .save-confirm-check-btn:active { transform: scale(0.92); }

    /* Modals & Toasts */
    .modal-sheet {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: #fff;
      color: #0f172a;
      border-top-left-radius: 20px;
      border-top-right-radius: 20px;
      padding: 20px 18px;
