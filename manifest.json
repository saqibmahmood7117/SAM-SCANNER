    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; user-select: none; }

    body { background: var(--bg-light); color: var(--text-dark); display: flex; flex-direction: column; height: 100vh; overflow: hidden; }



    /* =========================================================

       SCREEN 1: CAMSCANNER HOME DASHBOARD (IMAGE 1)

       ========================================================= */

    #homeScreen {

      display: flex;

      flex-direction: column;

      height: 100vh;

      overflow-y: auto;

      background: #f8fafc;

      padding-bottom: 70px;

    }



    /* Top Search Bar & Header Icons */

    .home-top-bar {

      padding: 12px 16px;

      display: flex;

      align-items: center;

      gap: 12px;

