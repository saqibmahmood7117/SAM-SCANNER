      z-index: 30;
      position: absolute;
      top: 0; left: 0; right: 0;
    }
    .cam-top-close { font-size: 1.5rem; cursor: pointer; color: #fff; padding: 4px; line-height: 1; }
    .cam-top-actions { display: flex; gap: 20px; align-items: center; font-size: 1.25rem; color: #fff; }
    .cam-top-actions span { cursor: pointer; }
    .cam-hd-badge { 
      font-size: 0.75rem; 
      border: 1.5px solid #00f0b5; 
      color: #00f0b5; 
      padding: 3px 8px; 
      border-radius: 6px; 
      font-weight: 800; 
      letter-spacing: 0.5px; 
      cursor: pointer; 
      background: rgba(0, 240, 181, 0.15); 
