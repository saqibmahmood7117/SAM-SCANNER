    .pill-mode-btn {

      padding: 5px 16px;

      border-radius: 16px;

      border: none;

      background: transparent;

      color: #94a3b8;

      font-size: 0.78rem;

      font-weight: 600;

      cursor: pointer;

    }

    .pill-mode-btn.active { background: #475569; color: #fff; }



    /* Mode Carousel */

    .cam-mode-carousel {

      position: absolute;

      bottom: 80px;

      left: 0;

      right: 0;

      display: flex;

      justify-content: center;

      gap: 20px;

      font-size: 0.8rem;

      font-weight: 600;

      color: #94a3b8;

      z-index: 25;

      overflow-x: auto;

      padding: 6px 12px;

      white-space: nowrap;

    }

    .cam-mode-item { cursor: pointer; transition: color 0.2s; position: relative; }

    .cam-mode-item.active { color: #00f0b5; }

    .cam-mode-item.active::after {

      content: "";

      position: absolute;

      bottom: -4px;

      left: 50%;

      transform: translateX(-50%);

      width: 4px;

      height: 4px;

      background: #ef4444;

      border-radius: 50%;

    }



    /* Bottom Shutter Deck (Image 2) */

    .cam-shutter-deck {

      height: 80px;

      background: rgba(0,0,0,0.85);

      display: flex;

      justify-content: space-around;

      align-items: center;

      padding: 0 20px;

      z-index: 30;

    }

    

    .cam-shutter-outer {

      width: 68px;

      height: 68px;

      border-radius: 50%;

      background: transparent;

      border: 3px solid #00f0b5;

      padding: 3px;

      display: flex;

      align-items: center;

      justify-content: center;

      cursor: pointer;

      box-shadow: 0 0 16px var(--shutter-glow);

    }

    .cam-shutter-inner {

      width: 100%;

      height: 100%;

      background: #ffffff;

      border-radius: 50%;

    }



    .cam-deck-btn {

      display: flex;

      flex-direction: column;

      align-items: center;

      gap: 3px;

      font-size: 0.7rem;

      color: #cbd5e1;

      cursor: pointer;

    }

    .cam-deck-icon { font-size: 1.4rem; }



    /* =========================================================

       SCREEN 3: EDIT, CROP & FILTER REVIEW SCREEN

       ========================================================= */

    #reviewScreen {

      display: none;

      flex-direction: column;

      height: 100vh;

      background: #0f172a;

      color: #fff;

    }

    .review-top-bar {

      height: 52px;

      padding: 0 14px;

      background: #1e293b;

      display: flex;

      justify-content: space-between;

      align-items: center;

      border-bottom: 1px solid #334155;

    }

    .review-viewport {

      flex: 1;

      position: relative;

      display: flex;

      align-items: center;

      justify-content: center;

      background: #000;

      overflow: hidden;

    }

    #cropCanvas, #displayCanvas { max-width: 100%; max-height: 100%; object-fit: contain; }



    .review-bottom-bar {

      background: #1e293b;

      display: flex;

      flex-direction: column;

      border-top: 1px solid #334155;

    }



    /* Universal Modal */

    .modal-sheet {

      position: fixed;

      bottom: 0; left: 0; right: 0;

      background: #fff;

      color: #0f172a;

      border-top-left-radius: 16px;

      border-top-right-radius: 16px;

      padding: 16px;

      display: none;

      flex-direction: column;

