        <div class="loupe-crosshair"></div>
      </div>
    </div>

    <div class="crop-bottom-bar">
      <button class="pill-btn secondary" onclick="autoDetectCornersOnCrop()">🪄 Auto Detect</button>
      <button class="pill-btn secondary" onclick="snapCornersToFull()">⏹️ Full Image</button>
      <button class="pill-btn secondary" onclick="rotateRawCapturedImage()">🔄 Rotate</button>
    </div>
  </div>

  <!-- VIEW 4: CAMSCANNER ENHANCE & REVIEW (IMAGE 2 REPLICA) -->
  <div id="reviewScreen" class="app-screen">
    <div class="review-top-bar">
      <div class="review-back-btn" onclick="handleNavigationBack()">←</div>
      <div class="review-title-box" onclick="promptRenameCurrentDoc()">
        <span class="review-title-text" id="reviewDocTitle">CamScanner 10-02-2026 13.10</span>
        <span style="font-size:0.9rem; color:#94a3b8;">✏️</span>
      </div>
      <div class="review-add-btn" onclick="addPageToCurrentDoc()">Add</div>
    </div>

    <div class="review-viewport">
      <div class="doc-page-container">
        <div class="page-delete-btn" onclick="deleteCurrentPage()" title="Delete Page">🗑️</div>
        <canvas id="displayCanvas"></canvas>

        <div class="page-floating-bar">
          <div class="page-indicator-pill">
            <span onclick="prevDocPage()">◄</span>
            <span id="pageCounterText">1/1</span>
            <span onclick="nextDocPage()">►</span>
          </div>

          <div class="compare-btn" id="compareBtn" 
               onmousedown="startCompareOriginal()" onmouseup="stopCompareOriginal()"
               ontouchstart="startCompareOriginal()" ontouchend="stopCompareOriginal()">
            <span>◧</span>
