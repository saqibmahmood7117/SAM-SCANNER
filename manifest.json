      transition: transform 0.2s;
    }
    .fab-camera:active { transform: scale(0.92); }

    /* Bottom Navigation Bar */
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 58px;
      background: #fff;
      border-top: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-around;
      align-items: center;
      z-index: 40;
      padding-bottom: env(safe-area-inset-bottom, 0);
    }
    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      font-size: 0.7rem;
      color: #64748b;
      cursor: pointer;
      flex: 1;
      padding: 6px 0;
      transition: color 0.15s;
    }
    .nav-item.active { color: #059669; font-weight: 700; }
    .nav-item span:first-child { font-size: 1.25rem; }

    /* =========================================================
       SCREEN 2: CAMERA & LIVE DETECT VIEW
       ========================================================= */
    #cameraScreen {
      background: #000;
      color: #fff;
      z-index: 20;
    }

    .cam-top-bar {
      height: 52px;
      padding: 0 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(6px);
      z-index: 30;
      position: relative;
    }
    .cam-top-actions { display: flex; gap: 16px; align-items: center; font-size: 1.25rem; }
    .cam-icon-btn { cursor: pointer; padding: 6px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .cam-icon-btn.active { color: #00f0b5; text-shadow: 0 0 10px #00f0b5; }

    .cam-viewport {
      flex: 1;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000;
    }
    #cameraVideo { width: 100%; height: 100%; object-fit: cover; }
    
    #liveBoundaryCanvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 10;
    }
    #trackCanvas { display: none; }

    /* ID Card Overlay guide */
    #idCardGuideOverlay {
      position: absolute;
      inset: 0;
      display: none;
      pointer-events: none;
      z-index: 15;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 12px;
    }
    .id-card-frame {
      width: 82%;
      max-width: 320px;
      aspect-ratio: 1.586;
      border: 2px dashed #00f0b5;
      border-radius: 12px;
      box-shadow: 0 0 0 9999px rgba(0,0,0,0.55);
      position: relative;
    }
    .id-card-badge {
      background: rgba(0, 240, 181, 0.9);
      color: #042f2e;
      font-weight: 700;
      font-size: 0.8rem;
      padding: 4px 14px;
      border-radius: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    /* Permission Friendly Screen */
    #camPermissionNotice {
      position: absolute;
      inset: 0;
      background: #0a0f1d;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
      gap: 14px;
      z-index: 25;
    }

    /* Single / Batch Pill */
    .pill-mode-container {
      position: absolute;
      bottom: 126px;
      left: 0;
      right: 0;
      display: flex;
      justify-content: center;
      z-index: 25;
    }
    .pill-mode-box {
      background: rgba(30, 41, 59, 0.8);
      backdrop-filter: blur(8px);
      padding: 4px;
      border-radius: 20px;
      display: flex;
      gap: 4px;
      border: 1px solid rgba(255,255,255,0.15);
    }
    .pill-mode-btn {
      padding: 6px 18px;
      border-radius: 16px;
      border: none;
      background: transparent;
      color: #94a3b8;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
    }
    .pill-mode-btn.active { background: #059669; color: #fff; box-shadow: 0 2px 8px rgba(5, 150, 105, 0.4); }

    /* Mode Carousel */
    .cam-mode-carousel {
      position: absolute;
      bottom: 84px;
      left: 0;
      right: 0;
      display: flex;
      justify-content: center;
      gap: 22px;
      font-size: 0.82rem;
      font-weight: 600;
      color: #94a3b8;
      z-index: 25;
      overflow-x: auto;
      padding: 6px 16px;
      white-space: nowrap;
    }
    .cam-mode-item { cursor: pointer; transition: color 0.2s; position: relative; padding: 4px 2px; }
    .cam-mode-item.active { color: #00f0b5; }
    .cam-mode-item.active::after {
      content: "";
      position: absolute;
      bottom: -2px;
      left: 50%;
      transform: translateX(-50%);
      width: 4px;
      height: 4px;
      background: #00f0b5;
      border-radius: 50%;
      box-shadow: 0 0 6px #00f0b5;
    }

    /* Bottom Shutter Deck */
    .cam-shutter-deck {
      height: 84px;
      background: rgba(0,0,0,0.85);
      backdrop-filter: blur(8px);
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding: 0 20px;
      z-index: 30;
    }
    
    .cam-shutter-outer {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: transparent;
      border: 3px solid #00f0b5;
      padding: 3px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 0 16px var(--shutter-glow);
      transition: transform 0.1s;
    }
    .cam-shutter-outer:active { transform: scale(0.93); }
    .cam-shutter-inner {
      width: 100%;
      height: 100%;
      background: #ffffff;
      border-radius: 50%;
    }

    .cam-deck-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      font-size: 0.72rem;
      color: #cbd5e1;
      cursor: pointer;
      min-width: 60px;
      position: relative;
    }
    .cam-deck-icon { font-size: 1.45rem; }
    .batch-badge {
      position: absolute;
      top: -4px;
      right: 8px;
      background: #059669;
      color: #fff;
      border-radius: 50%;
      width: 18px;
      height: 18px;
      font-size: 0.68rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #000;
    }

    /* =========================================================
       SCREEN 3: INTERACTIVE CORNER CROP SCREEN (CamScanner Style)
       ========================================================= */
    #cropScreen {
      background: #0b0f19;
      color: #fff;
      z-index: 20;
    }
    .crop-top-bar {
      height: 52px;
      padding: 0 16px;
      background: #111827;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #1f2937;
    }
    .crop-viewport {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #030712;
      overflow: hidden;
      touch-action: none;
    }
    #cropInteractiveCanvas {
      max-width: 100%;
      max-height: 100%;
      touch-action: none;
    }
    /* Corner Magnifier Loupe */
    #cropLoupe {
      position: absolute;
      width: 110px;
      height: 110px;
      border-radius: 50%;
      border: 3px solid #00f0b5;
      box-shadow: 0 4px 16px rgba(0,0,0,0.6);
      display: none;
      pointer-events: none;
      z-index: 40;
      background: #000;
      overflow: hidden;
    }
    #cropLoupe canvas { width: 100%; height: 100%; }
    .loupe-crosshair {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 16px;
      height: 16px;
      pointer-events: none;
    }
    .loupe-crosshair::before, .loupe-crosshair::after {
      content: "";
      position: absolute;
      background: #00f0b5;
    }
    .loupe-crosshair::before { top: 7px; left: 0; right: 0; height: 2px; }
    .loupe-crosshair::after { left: 7px; top: 0; bottom: 0; width: 2px; }

    .crop-bottom-bar {
      background: #111827;
      border-top: 1px solid #1f2937;
      padding: 10px 16px;
      display: flex;
      justify-content: space-around;
      align-items: center;
    }

    /* =========================================================
       SCREEN 4: REVIEW, FILTER & MULTI-PAGE SCREEN
       ========================================================= */
    #reviewScreen {
      background: #0b0f19;
      color: #fff;
      z-index: 20;
    }
    .review-top-bar {
      height: 52px;
      padding: 0 14px;
      background: #111827;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #1f2937;
    }
    .doc-title-input {
      background: transparent;
      border: 1px dashed rgba(255,255,255,0.25);
      border-radius: 6px;
      color: #fff;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 4px 8px;
      text-align: center;
      max-width: 180px;
    }
    .review-viewport {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #030712;
      overflow: hidden;
    }
    #displayCanvas { max-width: 100%; max-height: 100%; object-fit: contain; box-shadow: 0 4px 20px rgba(0,0,0,0.5); }

    /* Multi-Page Strip */
    .page-strip-container {
      background: #111827;
      border-top: 1px solid #1f2937;
      padding: 8px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      overflow-x: auto;
    }
    .page-thumb-item {
      width: 44px;
      height: 58px;
      border-radius: 4px;
      border: 2px solid transparent;
      background: #1f2937;
      cursor: pointer;
      object-fit: cover;
      flex-shrink: 0;
      opacity: 0.6;
      transition: all 0.2s;
    }
    .page-thumb-item.active { border-color: #00f0b5; opacity: 1; transform: scale(1.05); }
    .add-page-thumb-btn {
      width: 44px;
      height: 58px;
      border-radius: 4px;
      border: 2px dashed #475569;
      background: transparent;
      color: #cbd5e1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    /* Filter Strip */
    .filter-scroll-strip {
      background: #0f172a;
      display: flex;
      gap: 12px;
      padding: 10px 14px;
      overflow-x: auto;
      border-top: 1px solid #1e293b;
    }
    .filter-chip {
      padding: 6px 14px;
      border-radius: 18px;
      border: 1px solid #334155;
      background: #1e293b;
      color: #cbd5e1;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s;
    }
    .filter-chip.active { background: #059669; color: #fff; border-color: #059669; }

    .review-bottom-actions {
      background: #111827;
      padding: 10px 14px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      border-top: 1px solid #1f2937;
    }
    .tool-icon-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      font-size: 0.72rem;
      color: #cbd5e1;
      cursor: pointer;
      background: none;
      border: none;
    }
    .tool-icon-btn span:first-child { font-size: 1.25rem; }

    /* Sliders bar */
    .sliders-panel {
      background: #1e293b;
      padding: 8px 16px;
      display: none;
      flex-direction: column;
      gap: 8px;
      font-size: 0.75rem;
    }
    .slider-row { display: flex; align-items: center; gap: 10px; }
    .slider-row input[type=range] { flex: 1; accent-color: #059669; }

    /* =========================================================
       MODAL SHEETS
       ========================================================= */
    .modal-sheet {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: #fff;
      color: #0f172a;
      border-top-left-radius: 20px;
      border-top-right-radius: 20px;
      padding: 20px 18px;
      display: none;
      flex-direction: column;
      gap: 14px;
      box-shadow: 0 -8px 30px rgba(0,0,0,0.35);
      z-index: 100;
      max-height: 85vh;
      overflow-y: auto;
      animation: slideUp 0.25s ease-out;
    }
    @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

    .modal-head { display: flex; justify-content: space-between; align-items: center; }
    .modal-head h3 { font-size: 1.05rem; font-weight: 700; color: #0f172a; }
    .modal-close { background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #64748b; padding: 4px; }

    .pill-btn {
      padding: 10px 18px;
      border-radius: 22px;
      border: none;
      font-weight: 600;
      font-size: 0.84rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.15s;
    }
    .pill-btn:active { transform: scale(0.97); }
    .pill-btn.primary { background: #059669; color: #fff; }
    .pill-btn.secondary { background: #f1f5f9; color: #334155; border: 1px solid #e2e8f0; }
    .pill-btn.danger { background: #ef4444; color: #fff; }

    #sigCanvas { background: #fff; border-radius: 10px; width: 100%; height: 180px; touch-action: none; cursor: crosshair; border: 2px dashed #cbd5e1; }
    
    /* OCR Results Box */
    .ocr-result-area {
      width: 100%;
      height: 180px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      padding: 10px;
      font-family: monospace;
      font-size: 0.85rem;
      resize: none;
      outline: none;
    }

    /* Toast Notification */
    #toastNotice {
      position: fixed;
      bottom: 84px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(15, 23, 42, 0.92);
      color: #fff;
      padding: 8px 18px;
      border-radius: 24px;
      font-size: 0.82rem;
      font-weight: 600;
      box-shadow: 0 4px 14px rgba(0,0,0,0.25);
      z-index: 1000;
      display: none;
      pointer-events: none;
      backdrop-filter: blur(4px);
      text-align: center;
      white-space: nowrap;
    }

    /* Progress bar */
    .progress-bar-container {
      width: 100%;
      height: 8px;
      background: #e2e8f0;
      border-radius: 4px;
      overflow: hidden;
      margin: 8px 0;
      display: none;
    }
    .progress-bar-fill {
      height: 100%;
      width: 0%;
      background: #059669;
      transition: width 0.2s;
    }

    /* Profile / Settings Card */
    .profile-card {
      display: flex;
      align-items: center;
      gap: 14px;
      background: #f8fafc;
      padding: 14px;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
    }
    .profile-avatar {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: #059669;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }
  </style>
</head>
<body>

  <!-- Floating Toast Notification -->
  <div id="toastNotice"></div>

  <!-- =========================================================
       VIEW 1: CAMSCANNER HOME SCREEN
       ========================================================= -->
  <div id="homeScreen" class="app-screen active">
    
    <div class="home-top-bar">
      <div class="search-box">
        <span>🔍</span>
        <input type="text" id="searchDocsInput" placeholder="Search files or OCR text" oninput="filterRecents(this.value)" />
      </div>
      <div class="top-icon-btn" title="Cloud Sync" onclick="showToast('Cloud sync is active (Auto-backup)')">☁️</div>
      <div class="top-icon-btn" title="Pro Mode" onclick="showToast('SAM-SCANNER Pro: All features unlocked!')">👑</div>
    </div>

    <!-- Quick Tools Grid -->
    <div class="quick-tools-grid">
      <div class="quick-tool-item" onclick="startScannerFlow('scan')">
        <div class="quick-tool-icon" style="background:#ecfdf5; color:#059669;">🖨️</div>
        <div class="quick-tool-label">Smart Scan</div>
      </div>
      <div class="quick-tool-item" onclick="startScannerFlow('batch')">
        <div class="quick-tool-icon" style="background:#f0fdf4; color:#16a34a;">📚</div>
        <div class="quick-tool-label">Batch Scan</div>
      </div>
      <div class="quick-tool-item" onclick="startScannerFlow('idcard')">
        <div class="quick-tool-icon" style="background:#f0fdfa; color:#0d9488;">🪪</div>
        <div class="quick-tool-label">ID Cards</div>
      </div>
      <div class="quick-tool-item" onclick="startScannerFlow('ocr')">
        <div class="quick-tool-icon" style="background:#faf5ff; color:#9333ea;">🔤</div>
        <div class="quick-tool-label">Extract Text</div>
      </div>
      <div class="quick-tool-item" onclick="openModalSheet('pdfToolsModal')">
        <div class="quick-tool-icon" style="background:#fee2e2; color:#ef4444;">📑</div>
        <div class="quick-tool-label">PDF Tools</div>
      </div>
      <div class="quick-tool-item" onclick="triggerFileInput()">
        <div class="quick-tool-icon" style="background:#eff6ff; color:#2563eb;">🖼️</div>
        <div class="quick-tool-label">Import Images</div>
      </div>
      <div class="quick-tool-item" onclick="triggerMergeToPdf()">
        <div class="quick-tool-icon" style="background:#fef3c7; color:#d97706;">📎</div>
        <div class="quick-tool-label">Merge to PDF</div>
      </div>
      <div class="quick-tool-item" onclick="openModalSheet('pdfToolsModal')">
        <div class="quick-tool-icon" style="background:#f1f5f9; color:#475569;">⊞</div>
        <div class="quick-tool-label">All Features</div>
      </div>
    </div>

    <!-- Recents Section -->
    <div class="recents-header">
      <div class="recents-title">
        <span>Recents</span>
        <span class="recents-badge" id="recentsCountBadge">0</span>
      </div>
      <div class="recents-actions">
        <span onclick="triggerFileInput()">+ Import</span>
      </div>
    </div>

    <div class="recents-list" id="recentsContainer"></div>

    <!-- Floating Action Camera Button -->
    <button class="fab-camera" onclick="startScannerFlow('scan')">📷</button>

    <!-- Bottom Navigation Bar -->
    <div class="bottom-nav">
      <div class="nav-item active" id="navHome" onclick="setNavActive('home'); navigateHome()">
        <span>🏠</span>
        <span>Home</span>
      </div>
      <div class="nav-item" id="navFiles" onclick="setNavActive('files'); navigateHome(); renderRecentsList(); showToast('All documents refreshed')">
        <span>📄</span>
        <span>Files</span>
      </div>
      <div class="nav-item" id="navTools" onclick="setNavActive('tools'); openModalSheet('pdfToolsModal')">
        <span>⊞</span>
        <span>Tools</span>
      </div>
      <div class="nav-item" id="navMe" onclick="setNavActive('me'); openModalSheet('settingsModal')">
        <span>👤</span>
        <span>Me</span>
      </div>
    </div>
  </div>


  <!-- =========================================================
       VIEW 2: CAMSCANNER CAMERA & LIVE DETECT
       ========================================================= -->
  <div id="cameraScreen" class="app-screen">
    
    <div class="cam-top-bar">
      <div class="cam-icon-btn" onclick="handleNavigationBack()">✕</div>
      <div class="cam-top-actions">
        <div class="cam-icon-btn" id="flashBtn" onclick="toggleFlash()" title="Toggle Torch">⚡</div>
        <div class="cam-icon-btn" onclick="flipCamera()" title="Switch Camera">🔄</div>
        <span style="font-size: 0.78rem; border: 1px solid rgba(255,255,255,0.7); padding: 1px 5px; border-radius: 4px; font-weight: 700;">HD</span>
        <div class="cam-icon-btn" onclick="openModalSheet('pdfToolsModal')">⋮</div>
      </div>
    </div>

    <div class="cam-viewport">
      <video id="cameraVideo" autoplay playsinline></video>
      <canvas id="liveBoundaryCanvas"></canvas>
      <canvas id="trackCanvas" width="240" height="320"></canvas>

      <!-- ID Card Overlay Guide -->
      <div id="idCardGuideOverlay">
        <div class="id-card-badge" id="idCardStepBadge">Step 1: Scan Front Side</div>
        <div class="id-card-frame"></div>
      </div>

      <!-- Friendly Fallback Screen -->
      <div id="camPermissionNotice">
        <div style="font-size:2.8rem;">📷</div>
        <h3 style="font-size:1.1rem; font-weight:700;">Live Camera Unavailable</h3>
        <p style="font-size:0.82rem; color:#94a3b8; max-width:290px; margin-bottom:12px; line-height:1.4;">
          Use your phone's built-in shutter or select photos from your gallery:
        </p>
        <button class="pill-btn primary" style="padding:12px 24px; font-size:0.9rem;" onclick="document.getElementById('nativeShutterInput').click()">
          Take Photo (Phone Camera)
        </button>
        <button class="pill-btn secondary" style="margin-top:6px;" onclick="document.getElementById('globalFileInput').click()">
          Choose from Gallery
        </button>
      </div>
    </div>

    <!-- Single / Batch Pill -->
    <div class="pill-mode-container">
      <div class="pill-mode-box">
        <button class="pill-mode-btn active" id="singlePill" onclick="setCapturePill('single')">Single</button>
        <button class="pill-mode-btn" id="batchPill" onclick="setCapturePill('batch')">Batch</button>
      </div>
    </div>

    <!-- Mode Carousel -->
    <div class="cam-mode-carousel">
      <span class="cam-mode-item active" onclick="setCamMode('scan')">Scan</span>
      <span class="cam-mode-item" onclick="setCamMode('batch')">Batch</span>
      <span class="cam-mode-item" onclick="setCamMode('idcard')">ID Cards</span>
      <span class="cam-mode-item" onclick="setCamMode('ocr')">Extract Text</span>
      <span class="cam-mode-item" onclick="setCamMode('word')">To Word</span>
    </div>

    <!-- Bottom Shutter Deck -->
    <div class="cam-shutter-deck">
      <div class="cam-deck-btn" onclick="openModalSheet('pdfToolsModal')">
        <span class="cam-deck-icon">⊞</span>
        <span>Tools</span>
      </div>

      <!-- Universal Shutter -->
      <div class="cam-shutter-outer" onclick="handleShutterClick()">
        <div class="cam-shutter-inner"></div>
      </div>

      <!-- Right deck button: Gallery or Batch Finish -->
      <div class="cam-deck-btn" id="camRightDeckBtn" onclick="handleRightDeckClick()">
        <span class="cam-deck-icon" id="camRightDeckIcon">🖼️</span>
