  <script>

    let currentStream = null;

    let capturePillMode = "single";

    let currentCamMode = "scan";

    let liveTrackingInterval = null;



    let liveDetectedCorners = null;

    let smoothedCorners = null;

    let capturedRawImage = new Image();

    let unenhancedDewarped = null;



    let savedDocuments = JSON.parse(localStorage.getItem("sam_saved_docs") || "[]");



    const homeScreen = document.getElementById("homeScreen");

    const cameraScreen = document.getElementById("cameraScreen");

    const reviewScreen = document.getElementById("reviewScreen");

    const video = document.getElementById("cameraVideo");

    const liveCvs = document.getElementById("liveBoundaryCanvas");

    const liveCtx = liveCvs.getContext("2d");

    const trackCvs = document.getElementById("trackCanvas");

    const trackCtx = trackCvs.getContext("2d");

    const displayCvs = document.getElementById("displayCanvas");

    const displayCtx = displayCvs.getContext("2d");

    const sigCvs = document.getElementById("sigCanvas");

    const sigCtx = sigCvs.getContext("2d");

    const permNotice = document.getElementById("camPermissionNotice");



    function showHomeScreen() {

      stopCamera();

      cameraScreen.style.display = "none";

      reviewScreen.style.display = "none";

      homeScreen.style.display = "flex";

      renderRecentsList();

    }



    function renderRecentsList(filter = "") {

      const container = document.getElementById("recentsContainer");

      container.innerHTML = "";



      const list = filter 

        ? savedDocuments.filter(d => d.title.toLowerCase().includes(filter.toLowerCase()))

        : savedDocuments;



      if (list.length === 0) {

        container.innerHTML = `

          <div style="text-align:center; padding: 40px 20px; color:#94a3b8;">

            <div style="font-size:2.5rem; margin-bottom:8px;">📄</div>

            <p style="font-weight:600;">No scanned documents yet</p>

            <p style="font-size:0.8rem; margin-top:4px;">Tap the camera button below to scan your first document</p>

          </div>

        `;

        return;

      }



      list.forEach((doc, idx) => {

        const card = document.createElement("div");

        card.className = "doc-card";

        card.innerHTML = `

          <div class="doc-card-main">

            <img src="${doc.thumb || doc.pages[0]}" class="doc-thumb" />

            <div class="doc-info">

              <div class="doc-title">${doc.title}</div>

              <div class="doc-meta">${doc.date} | 📄 ${doc.pages.length}</div>

            </div>

            <input type="checkbox" style="width:18px; height:18px;" />

          </div>

          <div class="doc-card-actions">

            <div class="doc-action-btn" onclick="shareDoc(${idx})">Share</div>

            <div class="doc-action-btn" onclick="downloadDocPdf(${idx})">Save as PDF</div>

            <div class="doc-action-btn" onclick="viewDoc(${idx})">View</div>

          </div>

        `;

        container.appendChild(card);

      });

    }



    function filterRecents(query) { renderRecentsList(query); }

    function triggerFileInput() { document.getElementById("globalFileInput").click(); }



    // Progressive Camera Initializer (Fixes Overconstrained Error)

    async function requestCameraStream() {

      const constraints = [

        { video: { facingMode: { ideal: "environment" }, width: { ideal: 1280 } }, audio: false },

        { video: { facingMode: "environment" }, audio: false },

        { video: true, audio: false }

      ];



      for (let c of constraints) {

        try {

          return await navigator.mediaDevices.getUserMedia(c);

        } catch (e) {

          console.warn("Retrying with relaxed camera constraint:", e);

        }

      }

      throw new Error("Camera stream denied or unavailable");

    }



    async function openCameraView(mode = "scan") {

      homeScreen.style.display = "none";

      reviewScreen.style.display = "none";

      cameraScreen.style.display = "flex";

      permNotice.style.display = "none";

      video.style.display = "block";

      setCamMode(mode);



      try {

        currentStream = await requestCameraStream();

        video.srcObject = currentStream;

        video.onloadedmetadata = () => {

          liveCvs.width = video.videoWidth;

          liveCvs.height = video.videoHeight;

          startLiveBoundaryTracking();

        };

      } catch (err) {

        // Show in-UI friendly fallback instead of alert

        video.style.display = "none";

        permNotice.style.display = "flex";

      }

    }



    function stopCamera() {

      if (liveTrackingInterval) clearInterval(liveTrackingInterval);

      if (currentStream) {

        currentStream.getTracks().forEach(t => t.stop());

        currentStream = null;

      }

    }



    function handleShutterClick() {

      // If live camera is actively streaming

      if (currentStream && video.videoWidth) {

        takePhotoAndAutoCrop();

      } else {

        // Direct phone shutter fallback

        document.getElementById("nativeShutterInput").click();

      }

    }



    function setCapturePill(type) {

      capturePillMode = type;

      document.getElementById("singlePill").classList.toggle("active", type === "single");

      document.getElementById("batchPill").classList.toggle("active", type === "batch");

    }



    function setCamMode(mode) {

      currentCamMode = mode;

      document.querySelectorAll(".cam-mode-item").forEach(el => el.classList.remove("active"));

      if (event && event.target && event.target.classList.contains("cam-mode-item")) {

        event.target.classList.add("active");

      }

    }



    // Real-Time Radial Ray-Casting Boundary Tracking

    function startLiveBoundaryTracking() {

      if (liveTrackingInterval) clearInterval(liveTrackingInterval);



      liveTrackingInterval = setInterval(() => {

        if (!video.videoWidth) return;



        const sw = 240;

        const sh = Math.round(240 * (video.videoHeight / video.videoWidth));

        trackCvs.width = sw;

        trackCvs.height = sh;

        trackCtx.drawImage(video, 0, 0, sw, sh);



        const d = trackCtx.getImageData(0, 0, sw, sh).data;

        const gray = new Uint8Array(sw * sh);

        for (let i = 0; i < d.length; i += 4) {

          gray[i / 4] = Math.round(0.299 * d[i] + 0.587 * d[i+1] + 0.114 * d[i+2]);

        }



        let bestCx = Math.floor(sw / 2), bestCy = Math.floor(sh / 2);

        let maxLum = 0;

        for (let y = Math.floor(sh * 0.3); y < sh * 0.7; y += 12) {

          for (let x = Math.floor(sw * 0.3); x < sw * 0.7; x += 12) {

            const lum = gray[y * sw + x];

            if (lum > maxLum) { maxLum = lum; bestCx = x; bestCy = y; }

          }

        }



        const numRays = 48;

        const boundaryPts = [];

        const scaleX = video.videoWidth / sw;

        const scaleY = video.videoHeight / sh;



        for (let i = 0; i < numRays; i++) {

          const angle = (2 * Math.PI * i) / numRays;

          const cosA = Math.cos(angle), sinA = Math.sin(angle);

          const maxR = Math.hypot(sw, sh);



          let foundR = null;

          for (let r = 12; r < maxR; r += 3) {

            const xIn = Math.round(bestCx + (r - 4) * cosA);

            const yIn = Math.round(bestCy + (r - 4) * sinA);

            const xOut = Math.round(bestCx + (r + 4) * cosA);

            const yOut = Math.round(bestCy + (r + 4) * sinA);



            if (xIn < 0 || xIn >= sw || yIn < 0 || yIn >= sh || xOut < 0 || xOut >= sw || yOut < 0 || yOut >= sh) break;

            

            if (gray[yIn * sw + xIn] - gray[yOut * sw + xOut] >= 22) {

              foundR = r;

              break;

            }

          }

          if (foundR !== null) {

            boundaryPts.push({ x: (bestCx + foundR * cosA) * scaleX, y: (bestCy + foundR * sinA) * scaleY });

          }

        }



        if (boundaryPts.length >= 18) {

          let tl = boundaryPts[0], tr = boundaryPts[0], br = boundaryPts[0], bl = boundaryPts[0];

          let minSum = Infinity, maxSum = -Infinity, minDiff = Infinity, maxDiff = -Infinity;



          for (let pt of boundaryPts) {

            const s = pt.x + pt.y, diff = pt.x - pt.y;

            if (s < minSum) { minSum = s; tl = pt; }

            if (s > maxSum) { maxSum = s; br = pt; }

            if (diff > maxDiff) { maxDiff = diff; tr = pt; }

            if (diff < minDiff) { minDiff = diff; bl = pt; }

          }



          const rawCorners = [tl, tr, br, bl];



          if (!smoothedCorners) {

            smoothedCorners = rawCorners;

          } else {

            for (let c = 0; c < 4; c++) {

              smoothedCorners[c].x = smoothedCorners[c].x * 0.65 + rawCorners[c].x * 0.35;

              smoothedCorners[c].y = smoothedCorners[c].y * 0.65 + rawCorners[c].y * 0.35;

            }

          }

          liveDetectedCorners = smoothedCorners;

          drawLiveCyanPolygon(liveDetectedCorners);

        } else {

          liveCtx.clearRect(0, 0, liveCvs.width, liveCvs.height);

        }

      }, 100);

    }



    function drawLiveCyanPolygon(pts) {

      liveCtx.clearRect(0, 0, liveCvs.width, liveCvs.height);



      liveCtx.save();

      liveCtx.beginPath();

      liveCtx.moveTo(pts[0].x, pts[0].y);

      liveCtx.lineTo(pts[1].x, pts[1].y);

      liveCtx.lineTo(pts[2].x, pts[2].y);

      liveCtx.lineTo(pts[3].x, pts[3].y);

      liveCtx.closePath();



      liveCtx.strokeStyle = "#00f0b5";

      liveCtx.lineWidth = 4;

      liveCtx.shadowColor = "#00f0b5";

      liveCtx.shadowBlur = 10;

      liveCtx.stroke();



      liveCtx.fillStyle = "rgba(0, 240, 181, 0.08)";

      liveCtx.fill();



      pts.forEach(pt => {

        liveCtx.beginPath();

        liveCtx.arc(pt.x, pt.y, 6, 0, 2 * Math.PI);

        liveCtx.fillStyle = "#ffffff";

        liveCtx.shadowBlur = 4;

        liveCtx.fill();

      });

      liveCtx.restore();

    }



    function takePhotoAndAutoCrop() {

      const snapCanvas = document.createElement("canvas");

      snapCanvas.width = video.videoWidth;

      snapCanvas.height = video.videoHeight;

      snapCanvas.getContext("2d").drawImage(video, 0, 0);



      const targetCorners = liveDetectedCorners || [

        { x: video.videoWidth * 0.1, y: video.videoHeight * 0.1 },

        { x: video.videoWidth * 0.9, y: video.videoHeight * 0.1 },

        { x: video.videoWidth * 0.9, y: video.videoHeight * 0.9 },

        { x: video.videoWidth * 0.1, y: video.videoHeight * 0.9 }

      ];



      capturedRawImage.onload = () => {

        stopCamera();

        dewarpAndRender(capturedRawImage, targetCorners);

      };

      capturedRawImage.src = snapCanvas.toDataURL("image/jpeg", 0.95);

    }



    function handleImportedFiles(e) {

      const file = e.target.files[0];

      if (!file) return;

      const reader = new FileReader();

      reader.onload = (evt) => {

        capturedRawImage.onload = () => {

          stopCamera();

          const corners = [

            { x: capturedRawImage.width * 0.08, y: capturedRawImage.height * 0.08 },

            { x: capturedRawImage.width * 0.92, y: capturedRawImage.height * 0.08 },

            { x: capturedRawImage.width * 0.92, y: capturedRawImage.height * 0.92 },

            { x: capturedRawImage.width * 0.08, y: capturedRawImage.height * 0.92 }

          ];

          dewarpAndRender(capturedRawImage, corners);

        };

        capturedRawImage.src = evt.target.result;

      };

      reader.readAsDataURL(file);

    }



    function dewarpAndRender(img, pts) {

      cameraScreen.style.display = "none";

      homeScreen.style.display = "none";

      reviewScreen.style.display = "flex";



      const p0 = pts[0], p1 = pts[1], p2 = pts[2], p3 = pts[3];

      const targetW = Math.round(Math.max(Math.hypot(p1.x - p0.x, p1.y - p0.y), Math.hypot(p2.x - p3.x, p2.y - p3.y)));

      const targetH = Math.round(Math.max(Math.hypot(p3.x - p0.x, p3.y - p0.y), Math.hypot(p2.x - p1.x, p2.y - p1.y)));



      displayCvs.width = targetW;

      displayCvs.height = targetH;



      const dx1 = p1.x - p2.x, dx2 = p3.x - p2.x, dx3 = p0.x - p1.x + p2.x - p3.x;

      const dy1 = p1.y - p2.y, dy2 = p3.y - p2.y, dy3 = p0.y - p1.y + p2.y - p3.y;

      const det = dx1 * dy2 - dx2 * dy1;



      let g = 0, h = 0;

      if (Math.abs(det) > 1e-5) {

        g = (dx3 * dy2 - dx2 * dy3) / det;

        h = (dx1 * dy3 - dx3 * dy1) / det;

      }

      const a = p1.x - p0.x + g * p1.x, b = p3.x - p0.x + h * p3.x, c = p0.x;

      const d = p1.y - p0.y + g * p1.y, e = p3.y - p0.y + h * p3.y, f = p0.y;



      function mapPt(u, v) {

        const denom = g * u + h * v + 1;

        return { x: (a * u + b * v + c) / denom, y: (d * u + e * v + f) / denom };

      }



      displayCtx.clearRect(0, 0, targetW, targetH);

      const N = 14;

      for (let i = 0; i < N; i++) {

        for (let j = 0; j < N; j++) {

          const u0 = i / N, v0 = j / N, u1 = (i + 1) / N, v1 = (j + 1) / N;

          const x0 = u0 * targetW, y0 = v0 * targetH;

          const x1 = u1 * targetW, y1 = v1 * targetH;



          const s00 = mapPt(u0, v0), s10 = mapPt(u1, v0);

          const s01 = mapPt(u0, v1), s11 = mapPt(u1, v1);



          drawTri(displayCtx, img, s00.x, s00.y, s10.x, s10.y, s01.x, s01.y, x0, y0, x1, y0, x0, y1);

          drawTri(displayCtx, img, s10.x, s10.y, s11.x, s11.y, s01.x, s01.y, x1, y0, x1, y1, x0, y1);

        }

      }



      unenhancedDewarped = document.createElement("canvas");

      unenhancedDewarped.width = targetW;

      unenhancedDewarped.height = targetH;

      unenhancedDewarped.getContext("2d").drawImage(displayCvs, 0, 0);



      applyMagicFilter("magic");

    }



    function drawTri(ctx, img, u0, v0, u1, v1, u2, v2, x0, y0, x1, y0_2, x2, y2) {

      ctx.save();

      ctx.beginPath();

      ctx.moveTo(x0, y0); ctx.lineTo(x1, y0_2); ctx.lineTo(x2, y2);

      ctx.closePath();

      ctx.clip();



      const delta = u0 * (v1 - v2) - v0 * (u1 - u2) + (u1 * v2 - u2 * v1);

      if (Math.abs(delta) > 1e-6) {

        const ma = (x0 * (v1 - v2) + x1 * (v2 - v0) + x2 * (v0 - v1)) / delta;

        const mc = (x0 * (u2 - u1) + x1 * (u0 - u2) + x2 * (u1 - u0)) / delta;

        const me = (x0 * (u1 * v2 - u2 * v1) + x1 * (u2 * v0 - u0 * v2) + x2 * (u0 * v1 - u1 * v0)) / delta;



        const mb = (y0 * (v1 - v2) + y0_2 * (v2 - v0) + y2 * (v0 - v1)) / delta;

        const md = (y0 * (u2 - u1) + y0_2 * (u0 - u2) + y2 * (u1 - u0)) / delta;

        const mf = (y0 * (u1 * v2 - u2 * v1) + y0_2 * (u2 * v0 - u0 * v2) + y2 * (u0 * v1 - u1 * v0)) / delta;



        ctx.transform(ma, mb, mc, md, me, mf);

        ctx.drawImage(img, 0, 0);

      }

      ctx.restore();

    }



    function applyMagicFilter(type) {

      displayCtx.drawImage(unenhancedDewarped, 0, 0);

      const imgData = displayCtx.getImageData(0, 0, displayCvs.width, displayCvs.height);

      const d = imgData.data;



      for (let i = 0; i < d.length; i += 4) {

        const r = d[i], g = d[i+1], b = d[i+2];

        const lum = 0.299 * r + 0.587 * g + 0.114 * b;



        if (type === "magic") {

          if (lum > 140) {

            d[i] = Math.min(255, r * 1.3 + 20);

            d[i+1] = Math.min(255, g * 1.3 + 20);

            d[i+2] = Math.min(255, b * 1.3 + 20);

          } else {

            d[i] = r * 0.72;

            d[i+1] = g * 0.72;

            d[i+2] = b * 0.72;

          }

        } else if (type === "bw") {

          const v = lum > 130 ? 255 : 0;

          d[i] = d[i+1] = d[i+2] = v;

        }

      }

      displayCtx.putImageData(imgData, 0, 0);

    }



    function saveToRecentsAndHome() {

      const now = new Date();

      const dateStr = `${String(now.getMonth()+1).padStart(2,'0')}/${String(now.getDate()).padStart(2,'0')}/${now.getFullYear()} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;

      const title = `CamScanner ${String(now.getDate()).padStart(2,'0')}-${String(now.getMonth()+1).padStart(2,'0')}-${now.getFullYear()} ${String(now.getHours()).padStart(2,'0')}.${String(now.getMinutes()).padStart(2,'0')}`;



      const newDoc = {

        title: title,

        date: dateStr,

        thumb: displayCvs.toDataURL("image/jpeg", 0.7),

        pages: [displayCvs.toDataURL("image/jpeg", 0.9)]

      };



      savedDocuments.unshift(newDoc);

      localStorage.setItem("sam_saved_docs", JSON.stringify(savedDocuments));

      showHomeScreen();

    }



    function downloadDocPdf(idx) {

      const doc = savedDocuments[idx];

      const { jsPDF } = window.jspdf;

      const pdf = new jsPDF({ orientation: "p", unit: "px", format: "a4" });

      const imgW = pdf.internal.pageSize.getWidth();

      const imgH = pdf.internal.pageSize.getHeight();

      pdf.addImage(doc.pages[0], "JPEG", 0, 0, imgW, imgH);

      pdf.save(`${doc.title}.pdf`);

    }



    function shareDoc(idx) {

      if (navigator.share) {

        navigator.share({ title: savedDocuments[idx].title, text: "Shared via SAM-SCANNER Pro" });

      } else {

        downloadDocPdf(idx);

      }

    }



    function viewDoc(idx) {

      const doc = savedDocuments[idx];

      const img = new Image();

      img.onload = () => {

        dewarpAndRender(img, [

          {x:0, y:0}, {x:img.width, y:0}, {x:img.width, y:img.height}, {x:0, y:img.height}

        ]);

      };

      img.src = doc.pages[0];

    }



    function openModal(id) { document.getElementById(id).style.display = "flex"; }

    function closeModal(id) { document.getElementById(id).style.display = "none"; }



    window.onload = showHomeScreen;

  </script>

