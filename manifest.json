      align-items: center;
      justify-content: center;
      transition: all 0.15s;
    }
    .filter-thumb-box canvas { width: 100%; height: 100%; object-fit: cover; }
    .filter-card.active .filter-thumb-box { border-color: #00f0b5; box-shadow: 0 0 10px rgba(0, 240, 181, 0.4); }
    .filter-label { font-size: 0.72rem; color: #94a3b8; font-weight: 600; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; }
    .filter-card.active .filter-label { color: #00f0b5; font-weight: 700; }

    /* Review Action Deck (Image 2) */
    .review-action-deck {
      background: #141923;
      border-top: 1px solid #1f2737;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 14px 6px 14px;
    }
    .review-action-item { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 0.72rem; color: #cbd5e1; cursor: pointer; flex: 1; }
    .review-action-item:active { transform: scale(0.95); }
    .review-action-icon { font-size: 1.35rem; line-height: 1; }

    .save-confirm-check-btn {
      width: 48px;
      height: 48px;
      background: #00c997;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
