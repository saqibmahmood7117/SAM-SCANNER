    .doc-action-btn { flex: 1; padding: 6px 0; border-radius: 6px; border: 1px solid #e2e8f0; background: #f8fafc; font-size: 0.75rem; font-weight: 600; color: #334155; cursor: pointer; text-align: center; }
    .doc-action-btn:active { background: #e2e8f0; }
    .doc-action-btn.danger { color: #ef4444; border-color: #fee2e2; background: #fff5f5; }

    .fab-camera {
      position: fixed;
