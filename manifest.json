      color: #fff;
      font-size: 1.1rem;
      cursor: pointer;
      z-index: 15;
      border: 1px solid rgba(255,255,255,0.2);
    }
    .page-delete-btn:active { transform: scale(0.92); }

    .page-floating-bar {
      position: absolute;
      bottom: 12px;
      left: 16px;
      right: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      z-index: 15;
    }
    .page-indicator-pill {
      background: rgba(24, 30, 42, 0.85);
      backdrop-filter: blur(6px);
      padding: 5px 14px;
      border-radius: 16px;
      font-size: 0.82rem;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 12px;
      pointer-events: auto;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .page-indicator-pill span { cursor: pointer; }

    .compare-btn {
      background: rgba(24, 30, 42, 0.85);
      backdrop-filter: blur(6px);
      padding: 5px 14px;
      border-radius: 16px;
      font-size: 0.82rem;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      pointer-events: auto;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .compare-btn:active { background: #00f0b5; color: #042f2e; }

    /* Filter Carousel (Image 2) */
    .filter-carousel-section {
      background: #141923;
      border-top: 1px solid #1f2737;
      padding: 12px 14px;
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .filter-carousel-section::-webkit-scrollbar { display: none; }
    .filter-card { display: flex; flex-direction: column; align-items: center; gap: 6px; cursor: pointer; flex-shrink: 0; width: 66px; }
    .filter-thumb-box {
      width: 66px;
      height: 78px;
      border-radius: 6px;
      overflow: hidden;
      border: 2px solid transparent;
      background: #242e40;
