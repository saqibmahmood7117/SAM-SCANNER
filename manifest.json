      <div class="profile-avatar">👤</div>
      <div>
        <div style="font-weight:700; font-size:1rem;">Saqib</div>
        <div style="font-size:0.75rem; color:#059669; font-weight:600;">👑 CamScanner Pro Active</div>
      </div>
    </div>
    <div style="display:flex; flex-direction:column; gap:10px; margin-top:4px;">
      <button class="pill-btn secondary" onclick="exportBackupData()">💾 Backup Documents (.json)</button>
      <button class="pill-btn secondary" onclick="triggerRestoreBackup()">📂 Restore from Backup</button>
      <button class="pill-btn danger" onclick="clearAllAppData()">🗑️ Clear All Scanned Data</button>
    </div>
    <div style="font-size:0.72rem; color:#94a3b8; text-align:center; margin-top:8px;">
      CamScanner Edition v3.0<br/>
      Client-Side Real-Time Document Detection & Magic Enhance Engine
    </div>
  </div>

  <!-- JAVASCRIPT CONTROLLER -->
  <script>
    let currentScreen = "home";
    let activeModal = null;
    let lastBackPressTime = 0;

    function initNavigationHistory() {
      window.history.replaceState({ screen: "home" }, "");
    }

    function switchScreen(targetScreen, params = {}) {
      if (currentScreen === targetScreen && !params.force) return;

      document.querySelectorAll(".app-screen").forEach(s => {
        s.classList.remove("active");
        s.style.display = "none";
      });
      const targetEl = document.getElementById(targetScreen + "Screen");
      if (targetEl) {
        targetEl.classList.add("active");
        targetEl.style.display = "flex";
      }

      const prevScreen = currentScreen;
      currentScreen = targetScreen;

      if (prevScreen === "camera" && targetScreen !== "camera") {
        stopCamera();
      }

      if (targetScreen === "home") {
        renderRecentsList();
        setNavActive("home");
      }
    }

    function pushScreen(screenName, params = {}) {
      window.history.pushState({ screen: screenName, params: params }, "");
      switchScreen(screenName, params);
    }

    function handleNavigationBack() {
      window.history.back();
    }

    function navigateHome() {
      if (currentScreen !== "home") {
        pushScreen("home");
      }
    }

    function openModalSheet(modalId) {
      if (activeModal) closeModalSheet(activeModal, true);
      const m = document.getElementById(modalId);
      if (!m) return;
      m.style.display = "flex";
      activeModal = modalId;
      window.history.pushState({ modal: modalId }, "");
    }

    function closeModalSheet(modalId, skipHistory = false) {
      const m = document.getElementById(modalId);
      if (m) m.style.display = "none";
      if (activeModal === modalId) activeModal = null;
      if (!skipHistory && window.history.state && window.history.state.modal === modalId) {
        window.history.back();
      }
    }

    window.addEventListener("popstate", (e) => {
      if (activeModal) {
        const m = document.getElementById(activeModal);
        if (m) m.style.display = "none";
        activeModal = null;
        if (e.state && e.state.screen === currentScreen) return;
      }

      const state = e.state;
      if (!state || state.screen === "home") {
        if (currentScreen !== "home") {
          switchScreen("home");
        } else {
          const now = Date.now();
          if (now - lastBackPressTime < 2200) {
            return;
          }
          lastBackPressTime = now;
          showToast("Press back again to exit");
          window.history.pushState({ screen: "home" }, "");
        }
        return;
      }

      if (state.screen) {
        switchScreen(state.screen, state.params || {});
      }
    });

    const HD_PRESETS = [
      { label: "HD", width: 1920, height: 1080, name: "HD 1080p (Sharp Text)" },
      { label: "4K", width: 3840, height: 2160, name: "Ultra HD (Max Sensor Resolution)" },
      { label: "SD", width: 1280, height: 720, name: "Standard 720p (Fast Mode)" }
    ];
    let currentHdIdx = 0;

    async function toggleHdResolution() {
      currentHdIdx = (currentHdIdx + 1) % HD_PRESETS.length;
      const preset = HD_PRESETS[currentHdIdx];
      const btn = document.getElementById("camHdBtn");
      if (btn) {
        btn.innerText = preset.label;
        if (preset.label === "4K") {
          btn.style.borderColor = "#00f0b5";
          btn.style.color = "#00f0b5";
          btn.style.background = "rgba(0, 240, 181, 0.25)";
        } else if (preset.label === "HD") {
          btn.style.borderColor = "#00f0b5";
          btn.style.color = "#00f0b5";
          btn.style.background = "rgba(0, 240, 181, 0.12)";
        } else {
          btn.style.borderColor = "#94a3b8";
          btn.style.color = "#94a3b8";
          btn.style.background = "rgba(148, 163, 184, 0.12)";
        }
      }

      if (currentStream) {
        try {
          const track = currentStream.getVideoTracks()[0];
          if (track && track.applyConstraints) {
            await track.applyConstraints({
              width: { ideal: preset.width },
              height: { ideal: preset.height }
            });
            const actualSettings = track.getSettings ? track.getSettings() : {};
            const actW = actualSettings.width || video.videoWidth || preset.width;
            const actH = actualSettings.height || video.videoHeight || preset.height;
            showToast(`${preset.name}: ${actW}x${actH}`);
            return;
          }
        } catch (e) {
          console.warn("applyConstraints fallback:", e);
        }

        try {
          stopCamera();
          currentStream = await requestCameraStream();
          video.srcObject = currentStream;
          video.onloadedmetadata = () => {
            liveCvs.width = video.videoWidth;
            liveCvs.height = video.videoHeight;
            startLiveBoundaryTracking();
            showToast(`${preset.name}: ${video.videoWidth}x${video.videoHeight}`);
          };
        } catch (err) {
          showToast(`${preset.name} active`);
        }
      } else {
        showToast(`Target Resolution: ${preset.name}`);
      }
    }

    let currentStream = null;
    let currentFacingMode = "environment";
    let torchActive = false;
    let autoEnhanceEnabled = true;
    let capturePillMode = "single";
    let currentCamMode = "scan";
    let liveTrackingInterval = null;

    let liveDetectedCorners = null;
    let smoothedCorners = null;
    let rawCapturedImage = new Image();
    let cropCorners = [];
    let activeCornerDragIdx = -1;
    let cropScale = 1;

    let docPages = [];
    let activePageIndex = 0;
    let idCardStep = 1;
    let idCardFrontCanvas = null;

    let wmSelectedStyle = "diagonal";
    let sigPenColor = "#0f172a";
    let isSigning = false;
    let lastSigPt = { x: 0, y: 0 };
    let sigHasStrokes = false;

    let savedDocuments = JSON.parse(localStorage.getItem("cam_saved_docs") || "[]");

    let video, liveCvs, liveCtx, trackCvs, trackCtx, cropCvs, cropCtx;
    let cropLoupe, loupeCvs, loupeCtx, displayCvs, displayCtx, sigCvs, sigCtx, permNotice;

    function initDomReferences() {
      video = document.getElementById("cameraVideo");
      liveCvs = document.getElementById("liveBoundaryCanvas");
      liveCtx = liveCvs.getContext("2d");
      trackCvs = document.getElementById("trackCanvas");
      trackCtx = trackCvs.getContext("2d");
      cropCvs = document.getElementById("cropInteractiveCanvas");
      cropCtx = cropCvs.getContext("2d");
      cropLoupe = document.getElementById("cropLoupe");
      loupeCvs = document.getElementById("cropLoupeCanvas");
      loupeCtx = loupeCvs.getContext("2d");
      displayCvs = document.getElementById("displayCanvas");
      displayCtx = displayCvs.getContext("2d");
      sigCvs = document.getElementById("sigCanvas");
      sigCtx = sigCvs.getContext("2d");
      permNotice = document.getElementById("camPermissionNotice");
    }

    let toastTimeout = null;
    function showToast(msg, duration = 2400) {
      const toast = document.getElementById("toastNotice");
      if (!toast) return;
      toast.innerText = msg;
      toast.style.display = "block";
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => { toast.style.display = "none"; }, duration);
    }

    function vibrateDevice(ms = 25) {
      if (navigator.vibrate) {
        try { navigator.vibrate(ms); } catch (e) {}
      }
    }

    function renderRecentsList(filter = "") {
      const container = document.getElementById("recentsContainer");
      const badge = document.getElementById("recentsCountBadge");
      if (!container) return;
      container.innerHTML = "";

      const list = filter 
        ? savedDocuments.filter(d => d.title.toLowerCase().includes(filter.toLowerCase()))
        : savedDocuments;

      if (badge) badge.innerText = savedDocuments.length;

      if (list.length === 0) {
        container.innerHTML = `
          <div style="text-align:center; padding: 48px 20px; color:#94a3b8;">
            <div style="font-size:2.8rem; margin-bottom:10px;">📄</div>
            <p style="font-weight:700; font-size:1rem; color:#475569;">No scanned documents yet</p>
            <p style="font-size:0.8rem; margin-top:4px;">Tap the green camera button below to scan</p>
          </div>
        `;
        return;
      }

      list.forEach((doc, idx) => {
        const card = document.createElement("div");
        card.className = "doc-card";
        const pageCount = (doc.pages && doc.pages.length) ? doc.pages.length : 1;
        const thumbSrc = doc.thumb || (doc.pages ? doc.pages[0] : "");

        card.innerHTML = `
          <div class="doc-card-main" onclick="viewSavedDoc(${idx})">
            <img src="${thumbSrc}" class="doc-thumb" />
            <div class="doc-info">
              <div class="doc-title">
                <span>${doc.title}</span>
                <span onclick="event.stopPropagation(); renameDoc(${idx})" style="font-size:0.85rem; color:#64748b; cursor:pointer;" title="Rename">✏️</span>
              </div>
              <div class="doc-meta">
                <span>${doc.date}</span>
                <span class="page-count-pill">📄 ${pageCount} ${pageCount === 1 ? 'page' : 'pages'}</span>
              </div>
            </div>
          </div>
          <div class="doc-card-actions">
            <div class="doc-action-btn" onclick="shareDoc(${idx})">📤 Share</div>
            <div class="doc-action-btn" onclick="downloadDocPdf(${idx})">📑 PDF</div>
            <div class="doc-action-btn" onclick="viewSavedDoc(${idx})">👁️ View</div>
            <div class="doc-action-btn danger" onclick="deleteDoc(${idx})">🗑️ Delete</div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function filterRecents(q) { renderRecentsList(q); }

    function deleteDoc(idx) {
      if (confirm(`Delete "${savedDocuments[idx].title}"?`)) {
        savedDocuments.splice(idx, 1);
        localStorage.setItem("cam_saved_docs", JSON.stringify(savedDocuments));
        renderRecentsList();
        showToast("Document deleted");
      }
    }

    function renameDoc(idx) {
      const current = savedDocuments[idx].title;
      const newTitle = prompt("Enter document title:", current);
      if (newTitle && newTitle.trim()) {
        savedDocuments[idx].title = newTitle.trim();
        localStorage.setItem("cam_saved_docs", JSON.stringify(savedDocuments));
        renderRecentsList();
        showToast("Renamed successfully");
      }
    }

    function triggerFileInput() {
      const fi = document.getElementById("globalFileInput");
      if (fi) fi.click();
    }

    function triggerMergeToPdf() {
      const fi = document.getElementById("mergePdfFileInput");
      if (fi) fi.click();
    }

    async function requestCameraStream() {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        throw new Error("getUserMedia not supported");
      }
      const preset = HD_PRESETS[currentHdIdx];
      const constraints = [
        {
          video: {
            facingMode: { ideal: currentFacingMode },
            width: { ideal: preset.width },
            height: { ideal: preset.height },
            focusMode: { ideal: "continuous" }
          },
          audio: false
        },
        {
          video: {
            facingMode: { ideal: currentFacingMode },
            width: { ideal: 1920 },
            height: { ideal: 1080 }
          },
          audio: false
        },
        {
          video: {
            facingMode: currentFacingMode
          },
          audio: false
        },
        { video: true, audio: false }
      ];

      for (let c of constraints) {
        try {
          return await navigator.mediaDevices.getUserMedia(c);
        } catch (e) {
          console.warn("Retrying camera constraint:", e);
        }
      }
      throw new Error("Camera stream unavailable");
    }

    async function startScannerFlow(mode = "scan") {
      setCamMode(mode);
      pushScreen("camera");
      if (permNotice) permNotice.style.display = "none";
      if (video) video.style.display = "block";

      try {
        currentStream = await requestCameraStream();
        video.srcObject = currentStream;
        video.onloadedmetadata = () => {
          liveCvs.width = video.videoWidth;
          liveCvs.height = video.videoHeight;
          startLiveBoundaryTracking();
        };
      } catch (err) {
        console.warn("Camera fallback active:", err);
        if (video) video.style.display = "none";
        if (permNotice) permNotice.style.display = "flex";
      }
    }

    function stopCamera() {
      if (liveTrackingInterval) {
        clearInterval(liveTrackingInterval);
        liveTrackingInterval = null;
      }
      if (currentStream) {
        currentStream.getTracks().forEach(t => t.stop());
        currentStream = null;
      }
      torchActive = false;
      const flashBtn = document.getElementById("flashBtn");
      if (flashBtn) flashBtn.style.color = "#fff";
    }

    async function toggleFlash() {
      if (!currentStream) return;
      const track = currentStream.getVideoTracks()[0];
      if (!track) return;
      const caps = track.getCapabilities ? track.getCapabilities() : {};
      if ("torch" in caps) {
        torchActive = !torchActive;
        try {
          await track.applyConstraints({ advanced: [{ torch: torchActive }] });
          document.getElementById("flashBtn").style.color = torchActive ? "#00f0b5" : "#fff";
          showToast(torchActive ? "Torch On" : "Torch Off");
        } catch (e) {
          showToast("Torch toggle failed");
        }
      } else {
        showToast("Torch not supported on this camera");
      }
    }

    function toggleAutoEnhance() {
      autoEnhanceEnabled = !autoEnhanceEnabled;
      showToast(autoEnhanceEnabled ? "Magic Enhance: Active" : "Magic Enhance: Disabled");
    }

    async function flipCamera() {
      currentFacingMode = currentFacingMode === "environment" ? "user" : "environment";
      stopCamera();
      showToast("Switching camera...");
      try {
        currentStream = await requestCameraStream();
        video.srcObject = currentStream;
        video.onloadedmetadata = () => {
          liveCvs.width = video.videoWidth;
          liveCvs.height = video.videoHeight;
          startLiveBoundaryTracking();
        };
      } catch (e) {
        showToast("Camera switch failed");
      }
    }

    function setCamMode(mode) {
      currentCamMode = mode;
      document.querySelectorAll(".cam-mode-item").forEach(el => el.classList.remove("active"));
      
      const items = document.querySelectorAll(".cam-mode-item");
      items.forEach(el => {
        if (el.innerText.toLowerCase().includes(mode.toLowerCase())) {
          el.classList.add("active");
        }
      });

      const idOverlay = document.getElementById("idCardGuideOverlay");
      if (mode === "idcard") {
        idOverlay.style.display = "flex";
        idCardStep = 1;
        idCardFrontCanvas = null;
        document.getElementById("idCardStepBadge").innerText = "Step 1: Scan Front Side";
        capturePillMode = "single";
      } else {
        idOverlay.style.display = "none";
      }

      if (mode === "batch") {
        capturePillMode = "batch";
      } else if (mode === "scan") {
        capturePillMode = "single";
      }
      updateRightDeckBtn();
    }

    function updateRightDeckBtn() {
      const badge = document.getElementById("batchCountBadge");
      const icon = document.getElementById("camRightDeckIcon");
      const text = document.getElementById("camRightDeckText");

      if (capturePillMode === "batch" && docPages.length > 0) {
        badge.innerText = docPages.length;
        badge.style.display = "flex";
        icon.innerText = "✓";
        text.innerText = `Finish (${docPages.length})`;
      } else {
        badge.style.display = "none";
        icon.innerText = "🖼️";
        text.innerText = "Import Images";
      }
    }

    function handleRightDeckClick() {
      if (capturePillMode === "batch" && docPages.length > 0) {
        stopCamera();
        pushScreen("review");
        setupReviewScreen();
      } else {
        triggerFileInput();
      }
    }

    /* 6. BOUNDARY DETECTOR */
    function detectCornersFromImage(sourceCanvasOrVideo) {
      const srcW = sourceCanvasOrVideo.videoWidth || sourceCanvasOrVideo.width;
      const srcH = sourceCanvasOrVideo.videoHeight || sourceCanvasOrVideo.height;
      if (!srcW || !srcH) return null;

      const sw = 280;
      const sh = Math.round(280 * (srcH / srcW));
      trackCvs.width = sw;
      trackCvs.height = sh;
      trackCtx.drawImage(sourceCanvasOrVideo, 0, 0, sw, sh);

      const imgData = trackCtx.getImageData(0, 0, sw, sh);
      const d = imgData.data;
      const gray = new Uint8Array(sw * sh);
      let totalLum = 0;

      for (let i = 0; i < d.length; i += 4) {
        const lum = Math.round(0.299 * d[i] + 0.587 * d[i+1] + 0.114 * d[i+2]);
        gray[i / 4] = lum;
        totalLum += lum;
      }
      const avgLum = totalLum / (sw * sh);

      const paperPoints = [];
      const thresh = Math.max(70, Math.min(210, avgLum * 1.08));

      for (let y = Math.round(sh * 0.05); y < Math.round(sh * 0.95); y += 3) {
        for (let x = Math.round(sw * 0.05); x < Math.round(sw * 0.95); x += 3) {
          if (gray[y * sw + x] >= thresh) {
            paperPoints.push({ x, y });
          }
        }
      }

      const scaleX = srcW / sw;
      const scaleY = srcH / sh;

      if (paperPoints.length >= (sw * sh * 0.12) / 9) {
        let tl = paperPoints[0], tr = paperPoints[0], br = paperPoints[0], bl = paperPoints[0];
        let minSum = Infinity, maxSum = -Infinity, minDiff = Infinity, maxDiff = -Infinity;

        for (let pt of paperPoints) {
          const s = pt.x + pt.y;
          const diff = pt.x - pt.y;
          if (s < minSum) { minSum = s; tl = pt; }
          if (s > maxSum) { maxSum = s; br = pt; }
          if (diff > maxDiff) { maxDiff = diff; tr = pt; }
          if (diff < minDiff) { minDiff = diff; bl = pt; }
        }

        const cTL = { x: tl.x * scaleX, y: tl.y * scaleY };
        const cTR = { x: tr.x * scaleX, y: tr.y * scaleY };
        const cBR = { x: br.x * scaleX, y: br.y * scaleY };
        const cBL = { x: bl.x * scaleX, y: bl.y * scaleY };

        const area = 0.5 * Math.abs(
          (cTL.x * cTR.y - cTR.x * cTL.y) +
          (cTR.x * cBR.y - cBR.x * cTR.y) +
          (cBR.x * cBL.y - cBL.x * cBR.y) +
          (cBL.x * cTL.y - cTL.x * cBL.y)
        );
        const totalArea = srcW * srcH;

        if (area >= totalArea * 0.18 && area <= totalArea * 0.96) {
          return [cTL, cTR, cBR, cBL];
        }
      }

      const cx = Math.floor(sw / 2);
      const cy = Math.floor(sh / 2);
      const numRays = 36;
      const boundaryPts = [];

      for (let i = 0; i < numRays; i++) {
        const angle = (2 * Math.PI * i) / numRays;
        const cosA = Math.cos(angle);
        const sinA = Math.sin(angle);
        const maxR = Math.hypot(sw, sh) * 0.65;

        let foundR = null;
        for (let r = 16; r < maxR; r += 4) {
          const xIn = Math.round(cx + (r - 4) * cosA);
          const yIn = Math.round(cy + (r - 4) * sinA);
          const xOut = Math.round(cx + (r + 4) * cosA);
          const yOut = Math.round(cy + (r + 4) * sinA);

          if (xIn < 0 || xIn >= sw || yIn < 0 || yIn >= sh || xOut < 0 || xOut >= sw || yOut < 0 || yOut >= sh) {
            foundR = r;
            break;
          }

          if (Math.abs(gray[yIn * sw + xIn] - gray[yOut * sw + xOut]) >= 18) {
            foundR = r;
            break;
          }
        }
        if (foundR !== null) {
          boundaryPts.push({ x: (cx + foundR * cosA) * scaleX, y: (cy + foundR * sinA) * scaleY });
        }
      }

      if (boundaryPts.length >= 14) {
        let tl = boundaryPts[0], tr = boundaryPts[0], br = boundaryPts[0], bl = boundaryPts[0];
        let minSum = Infinity, maxSum = -Infinity, minDiff = Infinity, maxDiff = -Infinity;

        for (let pt of boundaryPts) {
          const s = pt.x + pt.y;
          const diff = pt.x - pt.y;
          if (s < minSum) { minSum = s; tl = pt; }
          if (s > maxSum) { maxSum = s; br = pt; }
          if (diff > maxDiff) { maxDiff = diff; tr = pt; }
          if (diff < minDiff) { minDiff = diff; bl = pt; }
        }

        return [tl, tr, br, bl];
      }

      return [
        { x: srcW * 0.06, y: srcH * 0.06 },
        { x: srcW * 0.94, y: srcH * 0.06 },
        { x: srcW * 0.94, y: srcH * 0.94 },
        { x: srcW * 0.06, y: srcH * 0.94 }
      ];
    }

    function startLiveBoundaryTracking() {
      if (liveTrackingInterval) clearInterval(liveTrackingInterval);

      liveTrackingInterval = setInterval(() => {
        if (!video.videoWidth || currentCamMode === "idcard") {
          liveCtx.clearRect(0, 0, liveCvs.width, liveCvs.height);
          return;
        }

        const detected = detectCornersFromImage(video);

        if (detected) {
          if (!smoothedCorners) {
            smoothedCorners = detected;
          } else {
            for (let c = 0; c < 4; c++) {
              smoothedCorners[c].x = smoothedCorners[c].x * 0.70 + detected[c].x * 0.30;
              smoothedCorners[c].y = smoothedCorners[c].y * 0.70 + detected[c].y * 0.30;
            }
          }
          liveDetectedCorners = smoothedCorners;
          drawLiveCyanPolygon(liveDetectedCorners);
        } else {
          liveCtx.clearRect(0, 0, liveCvs.width, liveCvs.height);
        }
      }, 100);
    }

    function drawLiveCyanPolygon(pts) {
      liveCtx.clearRect(0, 0, liveCvs.width, liveCvs.height);

      liveCtx.save();
      liveCtx.beginPath();
      liveCtx.moveTo(pts[0].x, pts[0].y);
      liveCtx.lineTo(pts[1].x, pts[1].y);
      liveCtx.lineTo(pts[2].x, pts[2].y);
      liveCtx.lineTo(pts[3].x, pts[3].y);
      liveCtx.closePath();

      liveCtx.strokeStyle = "#00f0b5";
      liveCtx.lineWidth = 3.5;
      liveCtx.shadowColor = "#00f0b5";
      liveCtx.shadowBlur = 12;
      liveCtx.stroke();

      liveCtx.fillStyle = "rgba(0, 240, 181, 0.09)";
      liveCtx.fill();

      pts.forEach(pt => {
        liveCtx.beginPath();
        liveCtx.arc(pt.x, pt.y, 6, 0, 2 * Math.PI);
        liveCtx.fillStyle = "#ffffff";
        liveCtx.shadowBlur = 6;
        liveCtx.fill();
      });
      liveCtx.restore();
    }

    /* 7. FULL SENSOR HD CAPTURE & AUTO-CROP */
    async function captureFullResolutionPhoto() {
      if (currentStream) {
        const videoTrack = currentStream.getVideoTracks()[0];
        if (window.ImageCapture && videoTrack) {
          try {
            const imageCapture = new ImageCapture(videoTrack);
            const photoBlob = await imageCapture.takePhoto({
              fillLightMode: torchActive ? "flash" : "off"
            });
            const bitmap = await createImageBitmap(photoBlob);
            const c = document.createElement("canvas");
            c.width = bitmap.width;
            c.height = bitmap.height;
            c.getContext("2d").drawImage(bitmap, 0, 0);
            return c;
          } catch (err) {
            console.warn("Hardware ImageCapture fallback to video canvas:", err);
          }
        }
      }

      const snapCanvas = document.createElement("canvas");
      snapCanvas.width = video.videoWidth || 1920;
      snapCanvas.height = video.videoHeight || 1080;
      snapCanvas.getContext("2d").drawImage(video, 0, 0, snapCanvas.width, snapCanvas.height);
      return snapCanvas;
    }

    async function handleShutterClick() {
      vibrateDevice(40);
      if (currentStream && video.videoWidth) {
        await processCameraCapture();
      } else {
        const ni = document.getElementById("nativeShutterInput");
        if (ni) ni.click();
      }
    }

    async function processCameraCapture() {
      showToast("Scanning & cropping page...");

      const photoCanvas = await captureFullResolutionPhoto();

      if (currentCamMode === "idcard") {
        handleIdCardCapture(photoCanvas);
        return;
      }

      const detected = detectCornersFromImage(photoCanvas) || (liveDetectedCorners ? JSON.parse(JSON.stringify(liveDetectedCorners)) : null) || [
        { x: photoCanvas.width * 0.06, y: photoCanvas.height * 0.06 },
        { x: photoCanvas.width * 0.94, y: photoCanvas.height * 0.06 },
        { x: photoCanvas.width * 0.94, y: photoCanvas.height * 0.94 },
        { x: photoCanvas.width * 0.06, y: photoCanvas.height * 0.94 }
      ];

      const dewarped = performDewarp(photoCanvas, detected);
      const enhanced = generateEnhancedCanvas(dewarped, "enhance");

      const newPage = {
        originalPhoto: photoCanvas,
        cropCorners: detected,
        rawDewarpedCanvas: dewarped,
        activeFilter: "enhance",
        enhancedCanvas: enhanced
      };

      if (capturePillMode === "batch") {
        docPages.push(newPage);
        showToast(`Captured page ${docPages.length}`);
        updateRightDeckBtn();
      } else {
        stopCamera();
        docPages = [newPage];
        activePageIndex = 0;
        pushScreen("review");
        setupReviewScreen();
        showToast("Page scanned! Extra boundaries cropped.");
      }
    }

    function handleIdCardCapture(snapCanvas) {
      const cardCanvas = extractIdCardRegion(snapCanvas);

      if (idCardStep === 1) {
        idCardFrontCanvas = cardCanvas;
        idCardStep = 2;
        document.getElementById("idCardStepBadge").innerText = "Step 2: Scan Back Side";
        showToast("Front captured! Now scan back side");
      } else {
        showToast("Assembling ID Card document...");
        stopCamera();
        const compositeCanvas = assembleIdCardComposite(idCardFrontCanvas, cardCanvas);
        docPages = [{
          originalPhoto: compositeCanvas,
          cropCorners: [
            { x: 0, y: 0 },
            { x: compositeCanvas.width, y: 0 },
            { x: compositeCanvas.width, y: compositeCanvas.height },
            { x: 0, y: compositeCanvas.height }
          ],
          rawDewarpedCanvas: compositeCanvas,
          activeFilter: "enhance",
          enhancedCanvas: generateEnhancedCanvas(compositeCanvas, "enhance")
        }];
        activePageIndex = 0;
        pushScreen("review");
        setupReviewScreen();
      }
    }

    function extractIdCardRegion(sourceCanvas) {
      const sw = sourceCanvas.width;
      const sh = sourceCanvas.height;
      const targetW = Math.round(sw * 0.82);
      const targetH = Math.round(targetW / 1.586);
      const cx = (sw - targetW) / 2;
      const cy = (sh - targetH) / 2;

      const card = document.createElement("canvas");
      card.width = targetW;
      card.height = targetH;
      card.getContext("2d").drawImage(sourceCanvas, cx, cy, targetW, targetH, 0, 0, targetW, targetH);
      return card;
    }

    function assembleIdCardComposite(frontCanvas, backCanvas) {
      const a4 = document.createElement("canvas");
      a4.width = 1240;
      a4.height = 1754;
      const ctx = a4.getContext("2d");

      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, a4.width, a4.height);

      ctx.fillStyle = "#059669";
      ctx.fillRect(0, 0, a4.width, 90);
      ctx.fillStyle = "#ffffff";
      ctx.font = "bold 32px sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("OFFICIAL ID CARD COPY", a4.width / 2, 58);

      const cardW = 860;
      const cardH = Math.round(cardW / 1.586);
      const cardX = (a4.width - cardW) / 2;

      ctx.fillStyle = "#334155";
      ctx.font = "600 24px sans-serif";
      ctx.fillText("[ FRONT SIDE ]", a4.width / 2, 170);
      ctx.drawImage(frontCanvas, cardX, 200, cardW, cardH);
      ctx.strokeStyle = "#cbd5e1";
      ctx.lineWidth = 3;
      ctx.strokeRect(cardX, 200, cardW, cardH);

      const backY = 200 + cardH + 110;
      ctx.fillStyle = "#334155";
      ctx.font = "600 24px sans-serif";
      ctx.fillText("[ BACK SIDE ]", a4.width / 2, backY - 30);
      ctx.drawImage(backCanvas, cardX, backY, cardW, cardH);
      ctx.strokeRect(cardX, backY, cardW, cardH);

      ctx.fillStyle = "#94a3b8";
      ctx.font = "20px sans-serif";
      ctx.fillText("Scanned & verified via CamScanner Edition", a4.width / 2, a4.height - 40);

      return a4;
    }

    function handleImportedFiles(e) {
      const files = Array.from(e.target.files);
      if (!files.length) return;

      showToast(`Importing ${files.length} image(s)...`);
      stopCamera();

      let loadedCount = 0;
      const newPages = [];

      files.forEach((file, idx) => {
        const reader = new FileReader();
        reader.onload = (evt) => {
          const img = new Image();
          img.onload = () => {
            const detected = detectCornersFromImage(img) || [
              { x: img.width * 0.05, y: img.height * 0.05 },
              { x: img.width * 0.95, y: img.height * 0.05 },
              { x: img.width * 0.95, y: img.height * 0.95 },
              { x: img.width * 0.05, y: img.height * 0.95 }
            ];
            const dewarped = performDewarp(img, detected);
            newPages[idx] = {
              originalPhoto: img,
              cropCorners: detected,
              rawDewarpedCanvas: dewarped,
              activeFilter: "enhance",
              enhancedCanvas: generateEnhancedCanvas(dewarped, "enhance")
            };
            loadedCount++;

            if (loadedCount === files.length) {
              docPages = newPages.filter(Boolean);
              activePageIndex = 0;
              pushScreen("review");
              setupReviewScreen();
            }
          };
          img.src = evt.target.result;
        };
        reader.readAsDataURL(file);
      });
    }

    function handleMergePdfFiles(e) {
      const files = Array.from(e.target.files);
      if (!files.length) return;

      showToast("Merging files to PDF...");
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({ orientation: "p", unit: "px", format: "a4" });
      const imgW = pdf.internal.pageSize.getWidth();
      const imgH = pdf.internal.pageSize.getHeight();

      let loaded = 0;
      files.forEach((f, idx) => {
        const r = new FileReader();
        r.onload = (evt) => {
          if (idx > 0) pdf.addPage();
          pdf.addImage(evt.target.result, "JPEG", 0, 0, imgW, imgH);
          loaded++;
          if (loaded === files.length) {
            pdf.save("Merged_Document.pdf");
            showToast("PDF generated and saved!");
          }
        };
        r.readAsDataURL(f);
      });
    }

    /* 8. MANUAL CROP */
    function initCropInteractiveCanvas() {
      const viewport = document.getElementById("cropViewport");
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;

      const iw = rawCapturedImage.width;
      const ih = rawCapturedImage.height;

      cropScale = Math.min((vw - 32) / iw, (vh - 32) / ih);
      const cw = Math.round(iw * cropScale);
      const ch = Math.round(ih * cropScale);

      cropCvs.width = cw;
      cropCvs.height = ch;

      drawInteractiveCropView();
      bindCropTouchEvents();
    }

    function drawInteractiveCropView() {
      cropCtx.clearRect(0, 0, cropCvs.width, cropCvs.height);
      cropCtx.drawImage(rawCapturedImage, 0, 0, cropCvs.width, cropCvs.height);

      cropCtx.save();
      cropCtx.fillStyle = "rgba(0, 0, 0, 0.55)";
      cropCtx.fillRect(0, 0, cropCvs.width, cropCvs.height);

      cropCtx.globalCompositeOperation = "destination-out";
      cropCtx.beginPath();
      cropCtx.moveTo(cropCorners[0].x * cropScale, cropCorners[0].y * cropScale);
      cropCtx.lineTo(cropCorners[1].x * cropScale, cropCorners[1].y * cropScale);
      cropCtx.lineTo(cropCorners[2].x * cropScale, cropCorners[2].y * cropScale);
      cropCtx.lineTo(cropCorners[3].x * cropScale, cropCorners[3].y * cropScale);
      cropCtx.closePath();
      cropCtx.fill();
      cropCtx.restore();

      cropCtx.save();
      cropCtx.beginPath();
      cropCtx.moveTo(cropCorners[0].x * cropScale, cropCorners[0].y * cropScale);
      cropCtx.lineTo(cropCorners[1].x * cropScale, cropCorners[1].y * cropScale);
      cropCtx.lineTo(cropCorners[2].x * cropScale, cropCorners[2].y * cropScale);
      cropCtx.lineTo(cropCorners[3].x * cropScale, cropCorners[3].y * cropScale);
      cropCtx.closePath();
      cropCtx.strokeStyle = "#00f0b5";
      cropCtx.lineWidth = 3.5;
      cropCtx.shadowColor = "#00f0b5";
      cropCtx.shadowBlur = 10;
      cropCtx.stroke();

      cropCorners.forEach((pt, i) => {
        const sx = pt.x * cropScale;
        const sy = pt.y * cropScale;

        cropCtx.beginPath();
        cropCtx.arc(sx, sy, 15, 0, 2 * Math.PI);
        cropCtx.fillStyle = i === activeCornerDragIdx ? "#00f0b5" : "rgba(0, 240, 181, 0.5)";
        cropCtx.fill();
        cropCtx.strokeStyle = "#ffffff";
        cropCtx.lineWidth = 3;
        cropCtx.stroke();

        cropCtx.beginPath();
        cropCtx.arc(sx, sy, 5, 0, 2 * Math.PI);
        cropCtx.fillStyle = "#ffffff";
        cropCtx.fill();
      });
      cropCtx.restore();
    }

    function bindCropTouchEvents() {
      let isDragging = false;

      function getCanvasCoords(e) {
        const rect = cropCvs.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return {
          x: clientX - rect.left,
          y: clientY - rect.top,
          screenX: clientX,
          screenY: clientY
        };
      }

      function onStart(e) {
        const pt = getCanvasCoords(e);
        let minD = Infinity;
        let bestIdx = -1;

        cropCorners.forEach((cp, idx) => {
          const d = Math.hypot(cp.x * cropScale - pt.x, cp.y * cropScale - pt.y);
          if (d < minD && d < 48) {
            minD = d;
            bestIdx = idx;
          }
        });

        if (bestIdx !== -1) {
          activeCornerDragIdx = bestIdx;
          isDragging = true;
          drawInteractiveCropView();
          updateLoupe(pt);
          cropLoupe.style.display = "block";
        }
      }

      function onMove(e) {
        if (!isDragging || activeCornerDragIdx === -1) return;
        e.preventDefault();
        const pt = getCanvasCoords(e);

        const natX = Math.max(0, Math.min(rawCapturedImage.width, pt.x / cropScale));
        const natY = Math.max(0, Math.min(rawCapturedImage.height, pt.y / cropScale));

        cropCorners[activeCornerDragIdx] = { x: natX, y: natY };
        drawInteractiveCropView();
        updateLoupe(pt);
      }

      function onEnd() {
        if (isDragging) {
          isDragging = false;
          activeCornerDragIdx = -1;
          cropLoupe.style.display = "none";
          drawInteractiveCropView();
        }
      }

      cropCvs.onmousedown = onStart;
      window.onmousemove = onMove;
      window.onmouseup = onEnd;

      cropCvs.ontouchstart = onStart;
      cropCvs.ontouchmove = onMove;
      cropCvs.ontouchend = onEnd;
    }

    function updateLoupe(pt) {
      const loupeSize = 110;
      const zoom = 2.4;
      const corner = cropCorners[activeCornerDragIdx];

      const viewport = document.getElementById("cropViewport");
      const vpRect = viewport.getBoundingClientRect();
      const lx = Math.max(10, Math.min(vpRect.width - loupeSize - 10, pt.screenX - vpRect.left - loupeSize / 2));
      const ly = Math.max(10, pt.screenY - vpRect.top - loupeSize - 32);

      cropLoupe.style.left = lx + "px";
      cropLoupe.style.top = ly + "px";

      loupeCtx.clearRect(0, 0, loupeSize, loupeSize);
      loupeCtx.drawImage(
        rawCapturedImage,
        corner.x - (loupeSize / (2 * zoom)),
        corner.y - (loupeSize / (2 * zoom)),
        loupeSize / zoom,
        loupeSize / zoom,
        0, 0,
        loupeSize, loupeSize
      );
    }

    function autoDetectCornersOnCrop() {
      const detected = detectCornersFromImage(rawCapturedImage);
      if (detected) {
        cropCorners = detected;
      } else {
        cropCorners = [
          { x: rawCapturedImage.width * 0.06, y: rawCapturedImage.height * 0.06 },
          { x: rawCapturedImage.width * 0.94, y: rawCapturedImage.height * 0.06 },
          { x: rawCapturedImage.width * 0.94, y: rawCapturedImage.height * 0.94 },
          { x: rawCapturedImage.width * 0.06, y: rawCapturedImage.height * 0.94 }
        ];
      }
      drawInteractiveCropView();
      showToast("Auto corners adjusted");
    }

    function snapCornersToFull() {
      cropCorners = [
        { x: 0, y: 0 },
        { x: rawCapturedImage.width, y: 0 },
        { x: rawCapturedImage.width, y: rawCapturedImage.height },
        { x: 0, y: rawCapturedImage.height }
      ];
      drawInteractiveCropView();
      showToast("Full image selected");
    }

    function rotateRawCapturedImage() {
      const rot = document.createElement("canvas");
      rot.width = rawCapturedImage.height;
      rot.height = rawCapturedImage.width;
      const rtx = rot.getContext("2d");
      rtx.translate(rot.width / 2, rot.height / 2);
      rtx.rotate(Math.PI / 2);
      rtx.drawImage(rawCapturedImage, -rawCapturedImage.width / 2, -rawCapturedImage.height / 2);

      const nImg = new Image();
      nImg.onload = () => {
        rawCapturedImage = nImg;
        autoDetectCornersOnCrop();
        initCropInteractiveCanvas();
      };
      nImg.src = rot.toDataURL("image/jpeg", 0.96);
    }

    function confirmCropAndProceed() {
      const dewarped = performDewarp(rawCapturedImage, cropCorners);
      const curFilter = (docPages[activePageIndex] && docPages[activePageIndex].activeFilter) ? docPages[activePageIndex].activeFilter : "enhance";
      const enhanced = generateEnhancedCanvas(dewarped, curFilter);

      if (docPages[activePageIndex]) {
        docPages[activePageIndex].rawDewarpedCanvas = dewarped;
        docPages[activePageIndex].enhancedCanvas = enhanced;
        docPages[activePageIndex].cropCorners = JSON.parse(JSON.stringify(cropCorners));
        docPages[activePageIndex].originalPhoto = rawCapturedImage;
      } else {
        docPages = [{
          originalPhoto: rawCapturedImage,
          cropCorners: JSON.parse(JSON.stringify(cropCorners)),
          rawDewarpedCanvas: dewarped,
          activeFilter: "enhance",
          enhancedCanvas: enhanced
        }];
        activePageIndex = 0;
      }

      pushScreen("review");
      setupReviewScreen();
      showToast("Crop applied");
    }

    function performDewarp(img, pts) {
      const p0 = pts[0], p1 = pts[1], p2 = pts[2], p3 = pts[3];
      const targetW = Math.round(Math.max(Math.hypot(p1.x - p0.x, p1.y - p0.y), Math.hypot(p2.x - p3.x, p2.y - p3.y)));
      const targetH = Math.round(Math.max(Math.hypot(p3.x - p0.x, p3.y - p0.y), Math.hypot(p2.x - p1.x, p2.y - p1.y)));

      const out = document.createElement("canvas");
      out.width = targetW;
      out.height = targetH;
      const ctx = out.getContext("2d");

      const dx1 = p1.x - p2.x, dx2 = p3.x - p2.x, dx3 = p0.x - p1.x + p2.x - p3.x;
      const dy1 = p1.y - p2.y, dy2 = p3.y - p2.y, dy3 = p0.y - p1.y + p2.y - p3.y;
      const det = dx1 * dy2 - dx2 * dy1;

      let g = 0, h = 0;
      if (Math.abs(det) > 1e-5) {
        g = (dx3 * dy2 - dx2 * dy3) / det;
        h = (dx1 * dy3 - dx3 * dy1) / det;
      }
      const a = p1.x - p0.x + g * p1.x, b = p3.x - p0.x + h * p3.x, c = p0.x;
      const d = p1.y - p0.y + g * p1.y, e = p3.y - p0.y + h * p3.y, f = p0.y;

      function mapPt(u, v) {
        const denom = g * u + h * v + 1;
        return { x: (a * u + b * v + c) / denom, y: (d * u + e * v + f) / denom };
      }

      ctx.clearRect(0, 0, targetW, targetH);
      const N = 14;
      for (let i = 0; i < N; i++) {
        for (let j = 0; j < N; j++) {
          const u0 = i / N, v0 = j / N, u1 = (i + 1) / N, v1 = (j + 1) / N;
          const x0 = u0 * targetW, y0 = v0 * targetH;
          const x1 = u1 * targetW, y1 = v1 * targetH;

          const s00 = mapPt(u0, v0), s10 = mapPt(u1, v0);
          const s01 = mapPt(u0, v1), s11 = mapPt(u1, v1);

          drawTri(ctx, img, s00.x, s00.y, s10.x, s10.y, s01.x, s01.y, x0, y0, x1, y0, x0, y1);
          drawTri(ctx, img, s10.x, s10.y, s11.x, s11.y, s01.x, s01.y, x1, y0, x1, y1, x0, y1);
        }
      }
      return out;
    }

    function drawTri(ctx, img, u0, v0, u1, v1, u2, v2, x0, y0, x1, y0_2, x2, y2) {
      ctx.save();
      ctx.beginPath();
      ctx.moveTo(x0, y0); ctx.lineTo(x1, y0_2); ctx.lineTo(x2, y2);
      ctx.closePath();
      ctx.clip();

      const delta = u0 * (v1 - v2) - v0 * (u1 - u2) + (u1 * v2 - u2 * v1);
      if (Math.abs(delta) > 1e-6) {
        const ma = (x0 * (v1 - v2) + x1 * (v2 - v0) + x2 * (v0 - v1)) / delta;
        const mc = (x0 * (u2 - u1) + x1 * (u0 - u2) + x2 * (u1 - u0)) / delta;
        const me = (x0 * (u1 * v2 - u2 * v1) + x1 * (u2 * v0 - u0 * v2) + x2 * (u0 * v1 - u1 * v0)) / delta;

        const mb = (y0 * (v1 - v2) + y0_2 * (v2 - v0) + y2 * (v0 - v1)) / delta;
        const md = (y0 * (u2 - u1) + y0_2 * (u0 - u2) + y2 * (u1 - u0)) / delta;
        const mf = (y0 * (u1 * v2 - u2 * v1) + y0_2 * (u2 * v0 - u0 * v2) + y2 * (u0 * v1 - u1 * v0)) / delta;

        ctx.transform(ma, mb, mc, md, me, mf);
        ctx.drawImage(img, 0, 0);
      }
      ctx.restore();
    }

    /* 9. ENHANCE FILTER */
    function generateEnhancedCanvas(sourceCanvas, filterType) {
      const out = document.createElement("canvas");
      out.width = sourceCanvas.width;
      out.height = sourceCanvas.height;
      const ctx = out.getContext("2d");
      ctx.drawImage(sourceCanvas, 0, 0);

      if (filterType === "original") {
        return out;
      }

      const imgData = ctx.getImageData(0, 0, out.width, out.height);
      const data = imgData.data;
      const width = out.width;
      const height = out.height;
      const len = width * height;

      const lum = new Float32Array(len);
      for (let i = 0; i < len; i++) {
        const idx = i * 4;
        lum[i] = 0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2];
      }

      const blockSize = Math.max(16, Math.floor(Math.min(width, height) / 20));
      const bxCount = Math.ceil(width / blockSize);
      const byCount = Math.ceil(height / blockSize);
      const bgRaw = new Float32Array(bxCount * byCount);

      for (let by = 0; by < byCount; by++) {
        for (let bx = 0; bx < bxCount; bx++) {
          let maxL = 0;
          const startX = bx * blockSize;
          const startY = by * blockSize;
          const endX = Math.min(width, startX + blockSize);
          const endY = Math.min(height, startY + blockSize);

          for (let y = startY; y < endY; y += 2) {
            for (let x = startX; x < endX; x += 2) {
              const l = lum[y * width + x];
              if (l > maxL) maxL = l;
            }
          }
          bgRaw[by * bxCount + bx] = Math.max(90, maxL);
        }
      }

      const bgGrid = new Float32Array(bxCount * byCount);
      for (let by = 0; by < byCount; by++) {
        for (let bx = 0; bx < bxCount; bx++) {
          let sum = 0, count = 0;
          for (let dy = -1; dy <= 1; dy++) {
            const ny = by + dy;
            if (ny < 0 || ny >= byCount) continue;
            for (let dx = -1; dx <= 1; dx++) {
              const nx = bx + dx;
              if (nx < 0 || nx >= bxCount) continue;
              sum += bgRaw[ny * bxCount + nx];
              count++;
            }
          }
          bgGrid[by * bxCount + bx] = sum / count;
        }
      }

      for (let y = 0; y < height; y++) {
        const by = Math.min(byCount - 1, Math.floor(y / blockSize));
        for (let x = 0; x < width; x++) {
          const bx = Math.min(bxCount - 1, Math.floor(x / blockSize));
          const bg = bgGrid[by * bxCount + bx];
          const idx = (y * width + x) * 4;

          let r = data[idx];
          let g = data[idx + 1];
          let b = data[idx + 2];
          const l = lum[y * width + x];

          if (filterType === "enhance" || filterType === "magic_pro") {
            const scale = 255.0 / Math.max(bg, 80.0);
            let rn = r * scale;
            let gn = g * scale;
            let bn = b * scale;
            const normLum = 0.299 * rn + 0.587 * gn + 0.114 * bn;

            if (normLum >= 195) {
              const f = 1.0 + ((normLum - 195) / (255 - 195)) * 0.35;
              rn = Math.min(255.0, rn * f);
              gn = Math.min(255.0, gn * f);
              bn = Math.min(255.0, bn * f);
            } else {
              const gamma = filterType === "magic_pro" ? 1.35 : 1.20;
              const factor = Math.pow(normLum / 195.0, gamma);
              const mult = (factor * 195.0) / Math.max(normLum, 1.0);
              rn = rn * mult;
              gn = gn * mult;
              bn = bn * mult;
            }

            const gray = 0.299 * rn + 0.587 * gn + 0.114 * bn;
            const sat = filterType === "enhance" ? 1.25 : 1.10;
            rn = gray + (rn - gray) * sat;
            gn = gray + (gn - gray) * sat;
            bn = gray + (bn - gray) * sat;

            data[idx] = Math.min(255, Math.max(0, Math.round(rn)));
            data[idx + 1] = Math.min(255, Math.max(0, Math.round(gn)));
            data[idx + 2] = Math.min(255, Math.max(0, Math.round(bn)));

          } else if (filterType === "no_shadow") {
            const scale = 255.0 / Math.max(bg, 80.0);
            data[idx] = Math.min(255, Math.round(r * scale));
            data[idx + 1] = Math.min(255, Math.round(g * scale));
            data[idx + 2] = Math.min(255, Math.round(b * scale));

          } else if (filterType === "bw") {
            const isPaper = l >= bg * 0.76;
            const val = isPaper ? 255 : 0;
            data[idx] = val;
            data[idx + 1] = val;
            data[idx + 2] = val;

          } else if (filterType === "gray") {
            const norm = Math.min(1.0, l / Math.max(bg, 80.0));
            let val;
            if (norm >= 0.78) {
              val = 255;
            } else {
              val = Math.min(255, Math.max(0, Math.round(Math.pow(norm / 0.78, 1.2) * 200)));
            }
            data[idx] = val;
            data[idx + 1] = val;
            data[idx + 2] = val;
          }
        }
      }

      ctx.putImageData(imgData, 0, 0);
      return out;
    }

    /* 10. REVIEW SCREEN CONTROLLER */
    function setupReviewScreen() {
      if (!docPages.length) return;
      renderActiveDocPage();
      updatePageCounterDisplay();
      generateFilterThumbnails();

      const now = new Date();
      const d = String(now.getDate()).padStart(2,'0');
      const m = String(now.getMonth()+1).padStart(2,'0');
      const y = now.getFullYear();
      const hh = String(now.getHours()).padStart(2,'0');
      const mm = String(now.getMinutes()).padStart(2,'0');
      document.getElementById("reviewDocTitle").innerText = `CamScanner ${d}-${m}-${y} ${hh}.${mm}`;
    }

    function renderActiveDocPage() {
      const page = docPages[activePageIndex];
      if (!page) return;

      displayCvs.width = page.enhancedCanvas.width;
      displayCvs.height = page.enhancedCanvas.height;
      displayCtx.drawImage(page.enhancedCanvas, 0, 0);

      highlightActiveFilterCard(page.activeFilter);
    }

    function updatePageCounterDisplay() {
      document.getElementById("pageCounterText").innerText = `${activePageIndex + 1}/${docPages.length}`;
    }

    function prevDocPage() {
      if (activePageIndex > 0) {
        activePageIndex--;
        renderActiveDocPage();
        updatePageCounterDisplay();
      }
    }

    function nextDocPage() {
      if (activePageIndex < docPages.length - 1) {
        activePageIndex++;
        renderActiveDocPage();
        updatePageCounterDisplay();
      }
    }

    function deleteCurrentPage() {
      if (docPages.length <= 1) {
        if (confirm("Delete this scanned document?")) {
          docPages = [];
          pushScreen("home");
        }
        return;
      }
      if (confirm(`Delete page ${activePageIndex + 1}?`)) {
        docPages.splice(activePageIndex, 1);
        if (activePageIndex >= docPages.length) activePageIndex = docPages.length - 1;
        renderActiveDocPage();
        updatePageCounterDisplay();
        generateFilterThumbnails();
        showToast("Page deleted");
      }
    }

    function addPageToCurrentDoc() {
      showToast("Opening camera to add page...");
      startScannerFlow("batch");
    }

    function startCompareOriginal() {
      const page = docPages[activePageIndex];
      if (!page) return;
      displayCtx.drawImage(page.rawDewarpedCanvas, 0, 0);
    }

    function stopCompareOriginal() {
      const page = docPages[activePageIndex];
      if (!page) return;
      displayCtx.drawImage(page.enhancedCanvas, 0, 0);
    }

    function applyCamScannerFilter(filterName) {
      const page = docPages[activePageIndex];
      if (!page) return;

      page.activeFilter = filterName;
      page.enhancedCanvas = generateEnhancedCanvas(page.rawDewarpedCanvas, filterName);
      renderActiveDocPage();
      highlightActiveFilterCard(filterName);
    }

    function highlightActiveFilterCard(filterName) {
      document.querySelectorAll(".filter-card").forEach(c => c.classList.remove("active"));
      const card = document.getElementById("fcard_" + filterName);
      if (card) card.classList.add("active");
    }

    function generateFilterThumbnails() {
      const page = docPages[activePageIndex];
      if (!page) return;

      const filters = ["enhance", "magic_pro", "no_shadow", "bw", "gray", "original"];
      filters.forEach(f => {
        const thumbCanvas = document.getElementById("fthumb_" + f);
        if (thumbCanvas) {
          thumbCanvas.width = 66;
          thumbCanvas.height = 78;
          const tCtx = thumbCanvas.getContext("2d");
          tCtx.drawImage(page.rawDewarpedCanvas, 0, 0, 66, 78);
          if (f !== "original") {
            const temp = generateEnhancedCanvas(thumbCanvas, f);
            tCtx.drawImage(temp, 0, 0);
          }
        }
      });
    }

    function rotateCurrentReviewPage() {
      const page = docPages[activePageIndex];
      if (!page) return;

      const rCanvas = (cvs) => {
        const rot = document.createElement("canvas");
        rot.width = cvs.height;
        rot.height = cvs.width;
        const rtx = rot.getContext("2d");
        rtx.translate(rot.width / 2, rot.height / 2);
        rtx.rotate(-Math.PI / 2);
        rtx.drawImage(cvs, -cvs.width / 2, -cvs.height / 2);
        return rot;
      };

      page.rawDewarpedCanvas = rCanvas(page.rawDewarpedCanvas);
      page.enhancedCanvas = generateEnhancedCanvas(page.rawDewarpedCanvas, page.activeFilter);
      renderActiveDocPage();
      generateFilterThumbnails();
      showToast("Rotated left 90°");
    }

    function reCropCurrentPage() {
      const page = docPages[activePageIndex];
      if (!page) return;

      const srcImg = page.originalPhoto;
      if (!srcImg) return;

      const nImg = new Image();
      nImg.onload = () => {
        rawCapturedImage = nImg;
        cropCorners = page.cropCorners ? JSON.parse(JSON.stringify(page.cropCorners)) : [
          { x: nImg.width * 0.05, y: nImg.height * 0.05 },
          { x: nImg.width * 0.95, y: nImg.height * 0.05 },
          { x: nImg.width * 0.95, y: nImg.height * 0.95 },
          { x: nImg.width * 0.05, y: nImg.height * 0.95 }
        ];
        pushScreen("crop");
        initCropInteractiveCanvas();
      };
      nImg.src = srcImg.toDataURL ? srcImg.toDataURL("image/jpeg", 0.96) : srcImg.src;
    }

    function promptRenameCurrentDoc() {
      const cur = document.getElementById("reviewDocTitle").innerText;
      const n = prompt("Document Title:", cur);
      if (n && n.trim()) {
        document.getElementById("reviewDocTitle").innerText = n.trim();
        showToast("Renamed");
      }
    }

    function saveToRecentsAndHome() {
      if (!docPages.length) return;
      const now = new Date();
      const dateStr = `${String(now.getMonth()+1).padStart(2,'0')}/${String(now.getDate()).padStart(2,'0')}/${now.getFullYear()} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
      const title = document.getElementById("reviewDocTitle").innerText.trim() || `CamScanner_${Date.now()}`;

      const pageUrls = docPages.map(p => p.enhancedCanvas.toDataURL("image/jpeg", 0.88));

      const newDoc = {
        title: title,
        date: dateStr,
        thumb: pageUrls[0],
        pages: pageUrls
      };

      savedDocuments.unshift(newDoc);
      localStorage.setItem("cam_saved_docs", JSON.stringify(savedDocuments));
      showToast("Saved to Recents!");
      pushScreen("home");
    }

    function viewSavedDoc(idx) {
      const doc = savedDocuments[idx];
      if (!doc || !doc.pages) return;

      showToast("Opening document...");
      document.getElementById("reviewDocTitle").innerText = doc.title;

      let loaded = 0;
      docPages = [];
      doc.pages.forEach((url, pIdx) => {
        const img = new Image();
        img.onload = () => {
          const cvs = document.createElement("canvas");
          cvs.width = img.width;
          cvs.height = img.height;
          cvs.getContext("2d").drawImage(img, 0, 0);
          docPages[pIdx] = {
            originalPhoto: img,
            cropCorners: [
              { x: 0, y: 0 },
              { x: img.width, y: 0 },
              { x: img.width, y: img.height },
              { x: 0, y: img.height }
            ],
            rawDewarpedCanvas: cvs,
            activeFilter: "enhance",
            enhancedCanvas: cvs
          };
          loaded++;
          if (loaded === doc.pages.length) {
            activePageIndex = 0;
            pushScreen("review");
            setupReviewScreen();
          }
        };
        img.src = url;
      });
    }

    /* 11. SIGNATURE TOOL */
    function openSignatureModal() {
      openModalSheet("sigModal");
      setTimeout(initSigPad, 100);
    }

    function initSigPad() {
      const rect = sigCvs.getBoundingClientRect();
      sigCvs.width = rect.width * 2;
      sigCvs.height = rect.height * 2;
      sigCtx.scale(2, 2);
      clearSignature();

      function getSigCoords(e) {
        const r = sigCvs.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return { x: clientX - r.left, y: clientY - r.top };
      }

      sigCvs.onmousedown = (e) => { isSigning = true; lastSigPt = getSigCoords(e); };
      window.onmousemove = (e) => {
        if (!isSigning) return;
        const pt = getSigCoords(e);
        sigCtx.beginPath();
        sigCtx.moveTo(lastSigPt.x, lastSigPt.y);
        sigCtx.lineTo(pt.x, pt.y);
        sigCtx.strokeStyle = sigPenColor;
        sigCtx.lineWidth = 3;
        sigCtx.lineCap = "round";
        sigCtx.stroke();
        lastSigPt = pt;
        sigHasStrokes = true;
      };
      window.onmouseup = () => { isSigning = false; };

      sigCvs.ontouchstart = (e) => { isSigning = true; lastSigPt = getSigCoords(e); };
      sigCvs.ontouchmove = (e) => {
        if (!isSigning) return;
        e.preventDefault();
        const pt = getSigCoords(e);
        sigCtx.beginPath();
        sigCtx.moveTo(lastSigPt.x, lastSigPt.y);
        sigCtx.lineTo(pt.x, pt.y);
        sigCtx.strokeStyle = sigPenColor;
        sigCtx.lineWidth = 3;
        sigCtx.lineCap = "round";
        sigCtx.stroke();
        lastSigPt = pt;
        sigHasStrokes = true;
      };
      sigCvs.ontouchend = () => { isSigning = false; };
    }

    function setSigColor(c) { sigPenColor = c; }
    function clearSignature() { sigCtx.clearRect(0, 0, sigCvs.width, sigCvs.height); sigHasStrokes = false; }

    function stampSignature() {
      if (!sigHasStrokes) { showToast("Draw signature first"); return; }
      const page = docPages[activePageIndex];
      if (!page) return;

      const sigImg = new Image();
      sigImg.onload = () => {
        const pageCvs = page.enhancedCanvas;
        const ctx = pageCvs.getContext("2d");
        const sigW = Math.round(pageCvs.width * 0.3);
        const sigH = Math.round(sigW * (sigCvs.height / sigCvs.width));
        const sigX = pageCvs.width - sigW - 30;
        const sigY = pageCvs.height - sigH - 30;

        ctx.drawImage(sigImg, sigX, sigY, sigW, sigH);
        renderActiveDocPage();
        closeModalSheet("sigModal");
        showToast("Signature stamped");
      };
      sigImg.src = sigCvs.toDataURL("image/png");
    }

    /* 12. WATERMARK TOOL */
    function openWatermarkModal() { openModalSheet("watermarkModal"); }

    function setWmStyle(s) {
      wmSelectedStyle = s;
      document.getElementById("wmStyleDiagonal").classList.toggle("primary", s === "diagonal");
      document.getElementById("wmStyleDiagonal").classList.toggle("secondary", s !== "diagonal");
      document.getElementById("wmStyleGrid").classList.toggle("primary", s === "grid");
      document.getElementById("wmStyleGrid").classList.toggle("secondary", s !== "grid");
    }

    function applyWatermark() {
      const page = docPages[activePageIndex];
      if (!page) return;

      const text = document.getElementById("wmText").value.trim() || "CONFIDENTIAL";
      const opacity = parseInt(document.getElementById("wmOpacity").value, 10) / 100;
      const pageCvs = page.enhancedCanvas;
      const ctx = pageCvs.getContext("2d");

      ctx.save();
      ctx.fillStyle = `rgba(220, 38, 38, ${opacity})`;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      if (wmSelectedStyle === "diagonal") {
        ctx.translate(pageCvs.width / 2, pageCvs.height / 2);
        ctx.rotate(-Math.PI / 4);
        ctx.font = `bold ${Math.round(pageCvs.width * 0.09)}px sans-serif`;
        ctx.fillText(text, 0, 0);
      } else {
        ctx.rotate(-Math.PI / 6);
        ctx.font = `600 ${Math.round(pageCvs.width * 0.045)}px sans-serif`;
        for (let y = -pageCvs.height; y < pageCvs.height * 2; y += 160) {
          for (let x = -pageCvs.width; x < pageCvs.width * 2; x += 320) {
            ctx.fillText(text, x, y);
          }
        }
      }
      ctx.restore();

      renderActiveDocPage();
      closeModalSheet("watermarkModal");
      showToast("Watermark applied");
    }

    /* 13. OCR TOOL */
    async function runOcrOnCurrentPage() {
      const page = docPages[activePageIndex];
      if (!page) { showToast("Open a document first"); return; }

      openModalSheet("ocrModal");
      const pBar = document.getElementById("ocrProgressBar");
      const pCont = document.getElementById("ocrProgressContainer");
      const msg = document.getElementById("ocrStatusMsg");
      const txtArea = document.getElementById("ocrTextResult");

      pCont.style.display = "block";
      pBar.style.width = "10%";
      msg.innerText = "Initializing OCR neural network...";
      txtArea.value = "";

      try {
        const worker = await Tesseract.createWorker("eng", 1, {
          logger: m => {
            if (m.status === "recognizing text") {
              const pct = Math.round(m.progress * 100);
              pBar.style.width = pct + "%";
              msg.innerText = `Recognizing text... ${pct}%`;
            }
          }
        });

        pBar.style.width = "75%";
        const res = await worker.recognize(page.enhancedCanvas.toDataURL("image/jpeg", 0.9));
        await worker.terminate();

        pBar.style.width = "100%";
        msg.innerText = "OCR Completed!";
        txtArea.value = res.data.text || "[No readable text detected]";
        showToast("Text extracted");
      } catch (err) {
        msg.innerText = "OCR failed: Ensure internet connection for Tesseract";
        showToast("OCR processing failed");
      }
    }

    function copyOcrText() {
      const txt = document.getElementById("ocrTextResult").value;
      if (!txt) { showToast("No text to copy"); return; }
      navigator.clipboard.writeText(txt).then(() => showToast("Copied to clipboard!"));
    }

    function downloadOcrTxt() {
      const txt = document.getElementById("ocrTextResult").value;
      if (!txt) return;
      const blob = new Blob([txt], { type: "text/plain;charset=utf-8" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `OCR_${Date.now()}.txt`;
      a.click();
    }

    /* 14. EXPORT & PDF SHARING */
    function downloadDocPdf(idx) {
      const doc = savedDocuments[idx];
      if (!doc) return;
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({ orientation: "p", unit: "px", format: "a4" });
      const imgW = pdf.internal.pageSize.getWidth();
      const imgH = pdf.internal.pageSize.getHeight();

      doc.pages.forEach((pUrl, pIdx) => {
        if (pIdx > 0) pdf.addPage();
        pdf.addImage(pUrl, "JPEG", 0, 0, imgW, imgH);
      });

      pdf.save(`${doc.title}.pdf`);
      showToast("PDF downloaded");
    }

    function shareDoc(idx) {
      const doc = savedDocuments[idx];
      if (!doc) return;
      if (navigator.share) {
        navigator.share({
          title: doc.title,
          text: `Shared document: ${doc.title} (${doc.pages.length} pages)`
        }).catch(() => {});
      } else {
        downloadDocPdf(idx);
      }
    }

    function exportWithPasswordPrompt() {
      const pwd = prompt("Enter a password for the PDF:");
      if (pwd) {
        showToast("Generating PDF...");
        const doc = docPages[activePageIndex];
        if (doc) {
          const { jsPDF } = window.jspdf;
          const pdf = new jsPDF({ orientation: "p", unit: "px", format: "a4" });
          pdf.addImage(doc.enhancedCanvas.toDataURL("image/jpeg", 0.9), "JPEG", 0, 0, pdf.internal.pageSize.getWidth(), pdf.internal.pageSize.getHeight());
          pdf.save("Protected_Doc.pdf");
        }
      }
    }

    function exportCurrentToWord() {
      const title = document.getElementById("reviewDocTitle").innerText || "Scanned Document";
      const ocrText = document.getElementById("ocrTextResult").value || "Scanned via CamScanner Edition";
      const page = docPages[activePageIndex];
      const imgData = page ? page.enhancedCanvas.toDataURL("image/jpeg", 0.7) : "";

      const html = `
        <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
        <head><title>${title}</title></head>
        <body style="font-family: Arial, sans-serif; padding: 20px;">
          <h2>${title}</h2>
          <p style="color:#666;">Generated with CamScanner Edition</p>
          <hr />
          <div style="text-align:center; margin: 15px 0;">
            <img src="${imgData}" style="max-width: 90%; border:1px solid #ccc;" />
          </div>
          <h3>Extracted Text</h3>
          <pre style="white-space: pre-wrap; font-family: Arial; font-size:12pt;">${ocrText}</pre>
        </body>
        </html>
      `;

      const blob = new Blob(['\ufeff' + html], { type: 'application/msword' });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `${title}.doc`;
      a.click();
      showToast("Word (.doc) exported!");
    }

    function exportCurrentToExcel() {
      const title = document.getElementById("reviewDocTitle").innerText || "Scanned Table";
      const ocrText = document.getElementById("ocrTextResult").value || "";
      
      let csv = "Line,Text Content\r\n";
      const lines = ocrText.split(/\r?\n/).filter(l => l.trim().length > 0);
      lines.forEach((l, i) => {
        csv += `"${i+1}","${l.replace(/"/g, '""')}"\r\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `${title}.csv`;
      a.click();
      showToast("Excel (.csv) exported!");
    }

    /* 15. PROFILE & SETTINGS */
    function setNavActive(name) {
      document.querySelectorAll(".nav-item").forEach(el => el.classList.remove("active"));
      const map = { home: "navHome", files: "navFiles", tools: "navTools", me: "navMe" };
      const id = map[name];
      if (id && document.getElementById(id)) document.getElementById(id).classList.add("active");
    }

    function clearAllAppData() {
      if (confirm("Delete ALL scanned documents? This cannot be undone.")) {
        savedDocuments = [];
        localStorage.removeItem("cam_saved_docs");
        renderRecentsList();
        closeModalSheet("settingsModal");
        showToast("All documents deleted");
      }
    }

    function exportBackupData() {
      const data = JSON.stringify(savedDocuments, null, 2);
      const blob = new Blob([data], { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `CamScanner_Backup_${Date.now()}.json`;
      a.click();
      showToast("Backup downloaded");
    }

    function triggerRestoreBackup() {
      const r = document.getElementById("restoreBackupInput");
      if (r) r.click();
    }

    function restoreBackupData(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const parsed = JSON.parse(evt.target.result);
          if (Array.isArray(parsed)) {
            savedDocuments = parsed;
            localStorage.setItem("cam_saved_docs", JSON.stringify(savedDocuments));
            renderRecentsList();
            closeModalSheet("settingsModal");
            showToast(`Restored ${savedDocuments.length} documents!`);
          }
        } catch (err) {
          showToast("Invalid backup file");
        }
      };
      reader.readAsText(file);
    }

    /* 16. BOOTSTRAP */
    window.addEventListener("DOMContentLoaded", () => {
      initDomReferences();
      initNavigationHistory();
      renderRecentsList();
      setWmStyle("diagonal");
    });
  </script>
</body>
</html>
Save both index.html and manifest.json in the same directory and open index.html directly on your device.

cant detect the full edge/contour detector

I've rebuilt the edge and contour detector in the app (now open in Canvas) so it locks onto the outer boundary of the page instead of getting tripped up by text lines or desk grain:

CamScanner Edition | Pro Document Scanner Suite
2D Morphological Closing (morphCloseChannel): Runs a separable 
7×7 dilation followed by erosion across the R, G, and B channels before edge detection, erasing dark printed text and table lines inside the sheet so internal content never confuses the outer boundary search.

4-Border Inward Contour Scan + Sobel Gradient: Compares the central paper color against the outer desk frame, computes 2D Sobel gradients, and scans inward from all four borders (top, bottom, left, right) to capture the true outer page perimeter—even when the page is tilted or resting on a light surface.

Iterative Max-Area Quadrilateral Fitting & 8-Handle Magnetic Crop: Fits the 4 corner vertices along the outer contour hull with a live "Page Contour Locked" status indicator, automatically crops and dewarps on shutter press, and adds 8 draggable handles (4 corners + 4 edge midpoints) with a 2.4x magnifier loupe when you tap Crop.

