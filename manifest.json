      <button class="pill-btn secondary" onclick="closeModalSheet('pdfToolsModal'); openSignatureModal()">PDF Signature</button>
      <button class="pill-btn secondary" onclick="closeModalSheet('pdfToolsModal'); openWatermarkModal()">Anti-Theft Watermark</button>
      <button class="pill-btn secondary" onclick="closeModalSheet('pdfToolsModal'); exportWithPasswordPrompt()">PDF Password Lock</button>
      <button class="pill-btn secondary" onclick="closeModalSheet('pdfToolsModal'); exportCurrentToWord()">Image to Word (.doc)</button>
      <button class="pill-btn secondary" onclick="closeModalSheet('pdfToolsModal'); exportCurrentToExcel()">Image to Excel (.csv)</button>
    </div>
  </div>

  <!-- MODAL 2: ELECTRONIC SIGNATURE -->
  <div class="modal-sheet" id="sigModal">
    <div class="modal-head">
      <h3>Electronic Signature</h3>
      <button class="modal-close" onclick="closeModalSheet('sigModal')">✕</button>
    </div>
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <span style="font-size:0.8rem; color:#64748b;">Sign with finger or stylus:</span>
      <div style="display:flex; gap:8px;">
        <span onclick="setSigColor('#0f172a')" style="width:20px; height:20px; border-radius:50%; background:#0f172a; cursor:pointer; display:inline-block; border:2px solid #cbd5e1;"></span>
        <span onclick="setSigColor('#2563eb')" style="width:20px; height:20px; border-radius:50%; background:#2563eb; cursor:pointer; display:inline-block;"></span>
        <span onclick="setSigColor('#dc2626')" style="width:20px; height:20px; border-radius:50%; background:#dc2626; cursor:pointer; display:inline-block;"></span>
      </div>
    </div>
    <canvas id="sigCanvas"></canvas>
    <div style="display: flex; gap: 8px; justify-content: space-between; margin-top: 6px;">
      <button class="pill-btn secondary" onclick="clearSignature()">Clear</button>
      <button class="pill-btn primary" onclick="stampSignature()">Apply Signature</button>
    </div>
  </div>

  <!-- MODAL 3: WATERMARK -->
  <div class="modal-sheet" id="watermarkModal">
    <div class="modal-head">
      <h3>Anti-Theft Watermark</h3>
      <button class="modal-close" onclick="closeModalSheet('watermarkModal')">✕</button>
    </div>
    <div style="display:flex; flex-direction:column; gap:8px;">
      <label style="font-size:0.8rem; color:#64748b;">Watermark Text:</label>
      <input type="text" id="wmText" value="CONFIDENTIAL" style="padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1; font-size:0.9rem;" />
      
      <label style="font-size:0.8rem; color:#64748b; margin-top:4px;">Watermark Style:</label>
      <div style="display:flex; gap:8px;">
        <button class="pill-btn secondary" id="wmStyleDiagonal" style="flex:1;" onclick="setWmStyle('diagonal')">Diagonal Center</button>
        <button class="pill-btn secondary" id="wmStyleGrid" style="flex:1;" onclick="setWmStyle('grid')">Full Grid Tile</button>
      </div>

      <label style="font-size:0.8rem; color:#64748b; margin-top:4px;">Opacity: <span id="wmOpacityVal">25%</span></label>
      <input type="range" id="wmOpacity" min="10" max="70" value="25" oninput="document.getElementById('wmOpacityVal').innerText = this.value + '%'" style="accent-color:#059669;" />
    </div>
    <button class="pill-btn primary" style="margin-top:6px;" onclick="applyWatermark()">Apply Watermark</button>
