      align-items: center; 
      justify-content: center; 
      min-width: 42px; 
    }
    .cam-hd-badge:active { transform: scale(0.92); background: rgba(0, 240, 181, 0.3); }

    .cam-viewport { flex: 1; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #000; height: 100%; width: 100%; }
    #cameraVideo { width: 100%; height: 100%; object-fit: cover; }
    #liveBoundaryCanvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; }
    #trackCanvas { display: none; }

    #idCardGuideOverlay { position: absolute; inset: 0; display: none; pointer-events: none; z-index: 15; align-items: center; justify-content: center; flex-direction: column; gap: 12px; }
    .id-card-frame { width: 82%; max-width: 320px; aspect-ratio: 1.586; border: 2px dashed #00f0b5; border-radius: 12px; box-shadow: 0 0 0 9999px rgba(0,0,0,0.55); position: relative; }
    .id-card-badge { background: rgba(0, 240, 181, 0.9); color: #042f2e; font-weight: 700; font-size: 0.8rem; padding: 4px 14px; border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.3); }

    #camPermissionNotice { position: absolute; inset: 0; background: #0a0f1d; display: none; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center; gap: 14px; z-index: 25; }

    .cam-bottom-section {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      display: flex;
      flex-direction: column;
      background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.65) 75%, transparent 100%);
      padding-bottom: env(safe-area-inset-bottom, 12px);
      z-index: 30;
    }
    .cam-mode-indicator {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 24px;
      padding: 8px 0 16px 0;
      font-size: 0.95rem;
      font-weight: 600;
      color: #94a3b8;
    }
    .cam-mode-item { cursor: pointer; position: relative; padding: 4px 0; }
    .cam-mode-item.active { color: #00f0b5; font-weight: 700; }
    .cam-mode-item.active::after {
      content: "";
      position: absolute;
      bottom: -2px;
      left: 20%;
      right: 20%;
      height: 2.5px;
      background: #00f0b5;
      border-radius: 2px;
      box-shadow: 0 0 6px #00f0b5;
    }

    .cam-shutter-deck { display: flex; justify-content: space-around; align-items: center; padding: 0 20px 18px 20px; }
    .cam-shutter-outer {
      width: 74px;
      height: 74px;
      border-radius: 50%;
      background: transparent;
      border: 3.5px solid #00f0b5;
      padding: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 0 20px var(--shutter-glow);
      transition: transform 0.1s;
    }
    .cam-shutter-outer:active { transform: scale(0.92); }
    .cam-shutter-inner { width: 100%; height: 100%; background: #ffffff; border-radius: 50%; }

    .cam-deck-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      font-size: 0.72rem;
      color: #e2e8f0;
      cursor: pointer;
      min-width: 70px;
      position: relative;
    }
    .cam-deck-btn:active { transform: scale(0.95); }
    .cam-deck-icon { font-size: 1.55rem; line-height: 1; }
    .batch-badge {
      position: absolute;
      top: -4px;
      right: 12px;
      background: #00f0b5;
      color: #042f2e;
      border-radius: 50%;
      width: 20px;
      height: 20px;
      font-size: 0.72rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #000;
    }

    /* SCREEN 3: INTERACTIVE CROP VIEW */
    #cropScreen { background: #0b0f19; color: #fff; z-index: 20; }
    .crop-top-bar { height: 52px; padding: 0 16px; background: #111827; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1f2937; }
    .crop-viewport { flex: 1; position: relative; display: flex; align-items: center; justify-content: center; background: #030712; overflow: hidden; touch-action: none; }
    #cropInteractiveCanvas { max-width: 100%; max-height: 100%; touch-action: none; }
    #cropLoupe {
      position: absolute;
      width: 110px;
      height: 110px;
      border-radius: 50%;
      border: 3px solid #00f0b5;
      box-shadow: 0 4px 20px rgba(0,0,0,0.7);
      display: none;
      pointer-events: none;
      z-index: 40;
      background: #000;
      overflow: hidden;
    }
    #cropLoupe canvas { width: 100%; height: 100%; }
    .loupe-crosshair { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 18px; height: 18px; pointer-events: none; }
    .loupe-crosshair::before, .loupe-crosshair::after { content: ""; position: absolute; background: #00f0b5; }
    .loupe-crosshair::before { top: 8px; left: 0; right: 0; height: 2px; }
    .loupe-crosshair::after { left: 8px; top: 0; bottom: 0; width: 2px; }
    .crop-bottom-bar { background: #111827; border-top: 1px solid #1f2937; padding: 12px 16px; display: flex; justify-content: space-around; align-items: center; }

    /* SCREEN 4: ENHANCE & REVIEW (IMAGE 2) */
    #reviewScreen { background: #11141c; color: #fff; z-index: 20; }
    .review-top-bar {
      height: 52px;
      padding: 0 16px;
      background: #181d28;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #222938;
    }
    .review-back-btn { font-size: 1.4rem; cursor: pointer; color: #fff; display: flex; align-items: center; }
    .review-title-box { display: flex; align-items: center; gap: 6px; cursor: pointer; }
    .review-title-text { font-weight: 700; font-size: 0.95rem; color: #fff; max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .review-add-btn { color: #00f0b5; font-weight: 700; font-size: 0.95rem; cursor: pointer; }

    .review-viewport {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0d1017;
      overflow: hidden;
      padding: 12px;
    }
    .doc-page-container { position: relative; max-width: 100%; max-height: 100%; display: flex; align-items: center; justify-content: center; }
    #displayCanvas { max-width: 100%; max-height: 100%; object-fit: contain; box-shadow: 0 6px 24px rgba(0,0,0,0.6); background: #fff; }

    .page-delete-btn {
      position: absolute;
      top: 10px;
      left: 10px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(0,0,0,0.65);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.1rem;
      cursor: pointer;
      z-index: 15;
      border: 1px solid rgba(255,255,255,0.2);
    }
    .page-delete-btn:active { transform: scale(0.92); }

    .page-floating-bar {
      position: absolute;
      bottom: 12px;
      left: 16px;
      right: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      z-index: 15;
    }
    .page-indicator-pill {
      background: rgba(24, 30, 42, 0.85);
      backdrop-filter: blur(6px);
      padding: 5px 14px;
      border-radius: 16px;
      font-size: 0.82rem;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 12px;
      pointer-events: auto;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .page-indicator-pill span { cursor: pointer; }

    .compare-btn {
      background: rgba(24, 30, 42, 0.85);
      backdrop-filter: blur(6px);
      padding: 5px 14px;
      border-radius: 16px;
      font-size: 0.82rem;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      pointer-events: auto;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .compare-btn:active { background: #00f0b5; color: #042f2e; }

    .filter-carousel-section {
      background: #141923;
      border-top: 1px solid #1f2737;
      padding: 12px 14px;
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .filter-carousel-section::-webkit-scrollbar { display: none; }
    .filter-card { display: flex; flex-direction: column; align-items: center; gap: 6px; cursor: pointer; flex-shrink: 0; width: 66px; }
    .filter-thumb-box {
      width: 66px;
      height: 78px;
      border-radius: 6px;
      overflow: hidden;
      border: 2px solid transparent;
      background: #242e40;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s;
    }
    .filter-thumb-box canvas { width: 100%; height: 100%; object-fit: cover; }
    .filter-card.active .filter-thumb-box { border-color: #00f0b5; box-shadow: 0 0 10px rgba(0, 240, 181, 0.4); }
    .filter-label { font-size: 0.72rem; color: #94a3b8; font-weight: 600; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; }
    .filter-card.active .filter-label { color: #00f0b5; font-weight: 700; }

    .review-action-deck {
      background: #141923;
      border-top: 1px solid #1f2737;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 14px 6px 14px;
    }
    .review-action-item { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 0.72rem; color: #cbd5e1; cursor: pointer; flex: 1; }
    .review-action-item:active { transform: scale(0.95); }
    .review-action-icon { font-size: 1.35rem; line-height: 1; }

    .save-confirm-check-btn {
      width: 48px;
      height: 48px;
      background: #00c997;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 1.6rem;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(0, 201, 151, 0.4);
      flex-shrink: 0;
      margin-left: 8px;
      transition: transform 0.1s;
    }
    .save-confirm-check-btn:active { transform: scale(0.92); }

    /* MODAL SHEETS & TOAST */
    .modal-sheet {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: #fff;
      color: #0f172a;
      border-top-left-radius: 20px;
      border-top-right-radius: 20px;
      padding: 20px 18px;
      display: none;
      flex-direction: column;
      gap: 14px;
      box-shadow: 0 -8px 30px rgba(0,0,0,0.35);
      z-index: 100;
      max-height: 85vh;
      overflow-y: auto;
      animation: slideUp 0.25s ease-out;
    }
    @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
    .modal-head { display: flex; justify-content: space-between; align-items: center; }
    .modal-head h3 { font-size: 1.05rem; font-weight: 700; color: #0f172a; }
    .modal-close { background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #64748b; padding: 4px; }

    .pill-btn {
      padding: 10px 18px;
      border-radius: 22px;
      border: none;
      font-weight: 600;
      font-size: 0.84rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.15s;
    }
    .pill-btn:active { transform: scale(0.97); }
    .pill-btn.primary { background: #059669; color: #fff; }
    .pill-btn.secondary { background: #f1f5f9; color: #334155; border: 1px solid #e2e8f0; }
    .pill-btn.danger { background: #ef4444; color: #fff; }

    #sigCanvas { background: #fff; border-radius: 10px; width: 100%; height: 180px; touch-action: none; cursor: crosshair; border: 2px dashed #cbd5e1; }
    .ocr-result-area { width: 100%; height: 180px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 10px; font-family: monospace; font-size: 0.85rem; resize: none; outline: none; }

    #toastNotice {
      position: fixed;
      bottom: 84px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(15, 23, 42, 0.92);
      color: #fff;
      padding: 8px 18px;
      border-radius: 24px;
      font-size: 0.82rem;
      font-weight: 600;
      box-shadow: 0 4px 14px rgba(0,0,0,0.25);
      z-index: 1000;
      display: none;
      pointer-events: none;
      backdrop-filter: blur(4px);
      text-align: center;
      white-space: nowrap;
    }
    .progress-bar-container { width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden; margin: 8px 0; display: none; }
    .progress-bar-fill { height: 100%; width: 0%; background: #059669; transition: width 0.2s; }
    .profile-card { display: flex; align-items: center; gap: 14px; background: #f8fafc; padding: 14px; border-radius: 12px; border: 1px solid #e2e8f0; }
    .profile-avatar { width: 52px; height: 52px; border-radius: 50%; background: #059669; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
  </style>
</head>
<body>
  <div id="toastNotice"></div>

  <!-- VIEW 1: HOME -->
  <div id="homeScreen" class="app-screen active">
    <div class="home-top-bar">
      <div class="search-box">
        <span>🔍</span>
        <input type="text" id="searchDocsInput" placeholder="Search files or OCR text" oninput="filterRecents(this.value)" />
      </div>
      <div class="top-icon-btn" title="Cloud Sync" onclick="showToast('Cloud sync is active (Auto-backup)')">☁️</div>
      <div class="top-icon-btn" title="Pro Mode" onclick="showToast('CamScanner Pro Edition: All features unlocked!')">👑</div>
    </div>

    <div class="quick-tools-grid">
      <div class="quick-tool-item" onclick="startScannerFlow('scan')">
        <div class="quick-tool-icon" style="background:#ecfdf5; color:#059669;">🖨️</div>
        <div class="quick-tool-label">Smart Scan</div>
      </div>
      <div class="quick-tool-item" onclick="startScannerFlow('batch')">
        <div class="quick-tool-icon" style="background:#f0fdf4; color:#16a34a;">📚</div>
        <div class="quick-tool-label">Batch Scan</div>
      </div>
      <div class="quick-tool-item" onclick="startScannerFlow('idcard')">
        <div class="quick-tool-icon" style="background:#f0fdfa; color:#0d9488;">🪪</div>
        <div class="quick-tool-label">ID Cards</div>
      </div>
      <div class="quick-tool-item" onclick="startScannerFlow('ocr')">
        <div class="quick-tool-icon" style="background:#faf5ff; color:#9333ea;">🔤</div>
        <div class="quick-tool-label">Extract Text</div>
      </div>
      <div class="quick-tool-item" onclick="openModalSheet('pdfToolsModal')">
        <div class="quick-tool-icon" style="background:#fee2e2; color:#ef4444;">📑</div>
        <div class="quick-tool-label">PDF Tools</div>
      </div>
      <div class="quick-tool-item" onclick="triggerFileInput()">
        <div class="quick-tool-icon" style="background:#eff6ff; color:#2563eb;">🖼️</div>
        <div class="quick-tool-label">Import Images</div>
      </div>
      <div class="quick-tool-item" onclick="triggerMergeToPdf()">
        <div class="quick-tool-icon" style="background:#fef3c7; color:#d97706;">📎</div>
        <div class="quick-tool-label">Merge to PDF</div>
      </div>
      <div class="quick-tool-item" onclick="openModalSheet('pdfToolsModal')">
        <div class="quick-tool-icon" style="background:#f1f5f9; color:#475569;">⊞</div>
        <div class="quick-tool-label">All Features</div>
      </div>
    </div>

    <div class="recents-header">
      <div class="recents-title">
        <span>Recents</span>
        <span class="recents-badge" id="recentsCountBadge">0</span>
      </div>
      <div class="recents-actions">
        <span onclick="triggerFileInput()">+ Import</span>
      </div>
    </div>

    <div class="recents-list" id="recentsContainer"></div>
    <button class="fab-camera" onclick="startScannerFlow('scan')">📷</button>

    <div class="bottom-nav">
      <div class="nav-item active" id="navHome" onclick="setNavActive('home'); navigateHome()">
        <span>🏠</span>
        <span>Home</span>
      </div>
      <div class="nav-item" id="navFiles" onclick="setNavActive('files'); navigateHome(); renderRecentsList(); showToast('All documents refreshed')">
        <span>📄</span>
        <span>Files</span>
      </div>
      <div class="nav-item" id="navTools" onclick="setNavActive('tools'); openModalSheet('pdfToolsModal')">
        <span>⊞</span>
        <span>Tools</span>
      </div>
      <div class="nav-item" id="navMe" onclick="setNavActive('me'); openModalSheet('settingsModal')">
        <span>👤</span>
        <span>Me</span>
      </div>
    </div>
  </div>

  <!-- VIEW 2: CAMERA -->
  <div id="cameraScreen" class="app-screen">
    <div class="cam-top-bar">
      <div class="cam-top-close" onclick="handleNavigationBack()">✕</div>
      <div class="cam-top-actions">
        <span id="flashBtn" onclick="toggleFlash()" title="Toggle Flash">⚡</span>
        <span onclick="toggleAutoEnhance()" title="Magic Enhance">✨</span>
        <span class="cam-hd-badge" id="camHdBtn" onclick="toggleHdResolution()" title="Toggle Camera Resolution">HD</span>
        <span onclick="openModalSheet('pdfToolsModal')">⋮</span>
      </div>
    </div>

    <div class="cam-viewport">
      <video id="cameraVideo" autoplay playsinline></video>
      <canvas id="liveBoundaryCanvas"></canvas>
      <canvas id="trackCanvas" width="240" height="320"></canvas>

      <div id="idCardGuideOverlay">
        <div class="id-card-badge" id="idCardStepBadge">Step 1: Scan Front Side</div>
        <div class="id-card-frame"></div>
      </div>

      <div id="camPermissionNotice">
        <div style="font-size:2.8rem;">📷</div>
        <h3 style="font-size:1.1rem; font-weight:700;">Live Camera Unavailable</h3>
        <p style="font-size:0.82rem; color:#94a3b8; max-width:290px; margin-bottom:12px; line-height:1.4;">
          Use your phone's camera directly or choose photos from your gallery:
        </p>
        <button class="pill-btn primary" style="padding:12px 24px; font-size:0.9rem;" onclick="document.getElementById('nativeShutterInput').click()">
          Take Photo (Phone Camera)
        </button>
        <button class="pill-btn secondary" style="margin-top:6px;" onclick="document.getElementById('globalFileInput').click()">
          Choose from Gallery
        </button>
      </div>
    </div>

    <div class="cam-bottom-section">
      <div class="cam-mode-indicator">
        <span class="cam-mode-item" onclick="setCamMode('idcard')">ID Cards</span>
        <span class="cam-mode-item active" id="modeScan" onclick="setCamMode('scan')">Scan</span>
        <span class="cam-mode-item" onclick="setCamMode('batch')">Batch</span>
        <span class="cam-mode-item" onclick="setCamMode('ocr')">Extract Text</span>
      </div>

      <div class="cam-shutter-deck">
        <div class="cam-deck-btn" onclick="flipCamera()">
          <span class="cam-deck-icon">🔄</span>
          <span>Flip</span>
        </div>

        <div class="cam-shutter-outer" onclick="handleShutterClick()">
          <div class="cam-shutter-inner"></div>
        </div>

        <div class="cam-deck-btn" id="camRightDeckBtn" onclick="handleRightDeckClick()">
